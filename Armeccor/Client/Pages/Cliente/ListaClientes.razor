@page "/Clientes"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        padding: 1.5rem;
    }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        }

        .info-card .titulo {
            font-size: 1.4rem;
            font-weight: 600;
        }

        .info-card .nro-ot {
            font-size: 1.6rem;
            font-weight: 700;
            margin-left: 10px;
        }
</style>

<div class="mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card info-card border-primary text-center">
                <div class="card-body d-flex justify-content-center align-items-center">

                    <span class="titulo text-primary">
                        Gestión de clientes
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="width: 48%;">
        <input class="form-control" placeholder="Buscar por nombre del cliente..." @bind="filtroNombre"/>
        <button class="btn btn-primary" @onclick="BuscarPorNombre">Buscar</button>
    </div>
    <div>
        <button class="btn btn-success" @onclick="IrANuevoCliente">+ Nuevo Cliente</button>
    </div>
</div>

@if (clientes == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>DNI</th>
                <th>Dirección</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@c.DNI</td>
                    <td>@c.Direccion</td>
                    <td>@c.Telefono</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => IrAEditarCliente(c.Id)">
                            Editar
                        </button>
                        <button class="btn btn-sm btn-danger"
                                disabled="@(isDeletingId == c.Id)"
                                @onclick="() => MenuDelete(c.Id, c.Nombre)">
                            @(isDeletingId == c.Id ? "Eliminando..." : "Eliminar")
                            
                        </button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<ConfirmationModal @ref="confirmationModal" OnConfirm="ConfirmDelete" />


@code {



    private List<Cliente> clientes = new();
    private ConfirmationModal? confirmationModal;
    private int? isDeletingId = null;

    protected override async Task OnInitializedAsync()
    {
        clientes = await Http.GetFromJsonAsync<List<Cliente>>("api/Clientes")
                   ?? new();
    }

    // ===============================
    // ABRIR MODAL
    // ===============================
    private async Task MenuDelete(int id, string nombre)
    {
        if (confirmationModal != null)
        {
            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar el cliente '{nombre}'?",
                id);
        }
    }

    // ===============================
    // CONFIRMAR DESDE MODAL
    // ===============================
    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmed && confirmationModal != null)
        {
            await ExecuteDelete(confirmationModal.CurrentItemId);
        }
        else
        {
            // Igual que en Órdenes
            await confirmationModal?.HideAsync();
        }
    }

    // ===============================
    // EJECUTAR DELETE
    // ===============================
    private async Task ExecuteDelete(int id)
    {
        try
        {
            isDeletingId = id;

            if (confirmationModal != null)
                await confirmationModal.HideAsync();

            var response = await Http.DeleteAsync($"api/Clientes/{id}");

            if (response.IsSuccessStatusCode)
            {
                // En vez de recargar todo, removemos del listado actual
                var clienteAEliminar = clientes.FirstOrDefault(c => c.Id == id);
                if (clienteAEliminar != null)
                    clientes.Remove(clienteAEliminar);

                await confirmationModal.ShowInfoAsync("El cliente fue eliminado correctamente");
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                // await JS.InvokeVoidAsync("alert",

                //     $"Error al eliminar cliente: {error}");

                await confirmationModal.ShowInfoAsync("No se pudo eliminar el cliente");
            }
        }
        catch (Exception ex)
        {

            // await JS.InvokeVoidAsync("alert",

            //     $"Error inesperado: {ex.Message}");

            await confirmationModal.ShowInfoAsync("Ocurrio un error en el servidor");
        }
        finally
        {
            isDeletingId = null;
        }
    }


    // ===============================
    // RESTO DE MÉTODOS QUE YA TENÍAS
    // ===============================

    private void IrANuevoCliente()
    {
        Navigation.NavigateTo("/Clientes/AgregarCliente");
    }

    public void IrAEditarCliente(int id)
    {
        Navigation.NavigateTo($"/Clientes/EditarCliente/{id}");
    }

    public async Task BuscarPorNombre()
    {
        if (string.IsNullOrWhiteSpace(filtroNombre))
        {
            await OnInitializedAsync();
        }
        else
        {
            clientes = clientes
                .Where(a => a.Nombre.Contains(filtroNombre,
                    StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private string filtroNombre = string.Empty;
}
