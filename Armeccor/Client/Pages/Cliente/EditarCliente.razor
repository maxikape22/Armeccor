            <ValidationMessage For="@(() => cliente.Direccion)" />
        </div>
    </div>

    <div class="form-group">
        <label>Telefono</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.Telefono" />
            <ValidationMessage For="@(() => cliente.Telefono)" />
        </div>
    </div>

    <br />
@*     <button class="btn btn-primary" type="submit">Aceptar</button>
 *@ 

  <button class="btn btn-primary" @onclick="Grabar">Aceptar</button>
 
  <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>

</EditForm>

<ConfirmationModal @ref="confirmationModal" />



@code
{
    private ConfirmationModal? confirmationModal;

    [Parameter] public int clienteId { get; set; }
    private Cliente cliente = new Cliente();
    private string Edicion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        //  await base.OnInitializedAsync();
        // // await Mostrar();
        //  var respuesta = await http.GetFromJsonAsync<Cliente>($"api/Clientes/{clienteId}");
        //  cliente = respuesta;
        // await base.OnInitializedAsync();
        // await Mostrar();
        await base.OnInitializedAsync();

        // Obtiene el área de la API usando el AreaId del parámetro de ruta.
        var respuesta = await http.GetFromJsonAsync<Cliente>($"api/Clientes/{clienteId}");

        // Asigna la respuesta a la propiedad 'Area' para que el formulario se llene con esos datos.
        cliente = respuesta;
    }

    private async Task Mostrar()
    {
        var respuesta = await http.GetFromJsonAsync<Cliente>($"api/Clientes/{clienteId}");
        //navigationManager.NavigateTo("/api/Clientes");  
    }

    // private async Task Grabar()
    // {
    //     var httpRespuesta = await http.PutAsJsonAsync<Cliente>($"api/Clientes/{clienteId}", cliente);
    //     navigationManager.NavigateTo("/Clientes");
    // }

    public class ActualizarContactoClienteDTO
    {
        public string Direccion { get; set; }

        public string Telefono { get; set; }
    }


    private bool guardando = false;

    private async Task Grabar()
    {
        guardando = true;

        var dto = new ActualizarContactoClienteDTO
        {
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono
        };

        var response = await http.PatchAsJsonAsync(
            $"api/Clientes/{clienteId}/Contacto",
            dto);

        guardando = false;

        if (response.IsSuccessStatusCode)
        {
            await confirmationModal?.ShowInfoAsync("Cliente actualizado correctamente.");
            navigationManager.NavigateTo("/Clientes");
        }
    }

    private void Cancelar()
    {
        navigationManager.NavigateTo("/Clientes");
    }
}