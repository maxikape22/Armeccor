@code {

    private ConfirmationModal? confirmationModal;
    private List<EntregaDetalleDTO>? entregas;

    private bool loading = true;
    private string? error;

    private string search = string.Empty;
    private bool filtroEntregado = true;
    private bool filtroNoEntregado = true;

    private int? isDeletingNroOT = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarEntregas();
    }

    // =============================
    // CAMBIAR ESTADO ENTREGADO
    // =============================

    private async Task CambiarEstadoEntrega(int id, bool nuevoEstado)
    {
        var response = await Http.PutAsJsonAsync(
            $"api/Entregas/ActualizacionPorEstado?Id={id}&Entregado={nuevoEstado}",
            new { });

        if (response.IsSuccessStatusCode)
        {
            var entregaActualizada =
                await response.Content.ReadFromJsonAsync<EntregaDetalleDTO>();

            if (entregaActualizada != null)
            {
                var index = entregas?.FindIndex(e => e.Id == id);

                if (index is >= 0)
                    entregas![index.Value] = entregaActualizada;
            }
        }
        else
        {
            //error = $"Error al actualizar entrega #{id}";
            await confirmationModal.ShowInfoAsync("No se pudo actualizar el estado de la entrega");
        }
    }

    // =============================
    // CARGAR
    // =============================

    private async Task CargarEntregas()
    {
        try
        {
            entregas =
                await Http.GetFromJsonAsync<List<EntregaDetalleDTO>>("api/Entregas");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        loading = false;
    }

    // =============================
    // FILTROS
    // =============================

    private IEnumerable<EntregaDetalleDTO> Filtrar(
        IEnumerable<EntregaDetalleDTO> lista)
    {
        var query = lista;

        if (!string.IsNullOrWhiteSpace(search))
            query = query.Where(e =>
                e.MedioDePago.Contains(search,
                StringComparison.OrdinalIgnoreCase));

        if (!filtroEntregado)
            query = query.Where(e => !e.Entregado);

        if (!filtroNoEntregado)
            query = query.Where(e => e.Entregado);

        return query;
    }

    // =============================
    // MODAL ELIMINAR
    // =============================

    private async Task MenuDelete(int nroOT)
    {
        if (confirmationModal != null)
        {
            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar la entrega N° {nroOT}?",
                nroOT);
        }
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmed && confirmationModal != null)
        {
            await Eliminar(confirmationModal.CurrentItemId);
        }
        else
        {
            // SOLO cerrar modal (igual que en Ordenes)
            if (confirmationModal != null)
                await confirmationModal.HideAsync();
        }
    }

    private async Task Eliminar(int nroOT)
    {
        try
        {
            isDeletingNroOT = nroOT;

            if (confirmationModal != null)
                await confirmationModal.HideAsync();

            var resp = await Http.DeleteAsync($"api/Entregas/{nroOT}");

            if (resp.IsSuccessStatusCode)
            {
                // Quitar de la lista sin recargar todo
                entregas = entregas?
                    .Where(e => e.NroOT != nroOT)
                    .ToList();

                // await JSRuntime.InvokeVoidAsync(
                //     "alert",
                //     "Entrega eliminada con éxito.");
                await confirmationModal.ShowInfoAsync("Entrega eliminada exitosamente");

            }
            else
            {
                var errorContent = await resp.Content.ReadAsStringAsync();

                // await JSRuntime.InvokeVoidAsync(
                //     "alert",
                //     $"Error al eliminar: {resp.StatusCode} - {errorContent}");
                await confirmationModal.ShowInfoAsync("No se pudo eliminar la entrega");
            }
        }
        catch (Exception ex)
        {
            // await JSRuntime.InvokeVoidAsync(
            //     "alert",
            //     $"Error inesperado: {ex.Message}");
            await confirmationModal.ShowInfoAsync("Error en el servidor");
        }
        finally
        {
            isDeletingNroOT = null;
        }
    }
}

