@page "/Entregas"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        padding: 1.5rem;
    }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        }

        .info-card .titulo {
            font-size: 1.4rem;
            font-weight: 600;
        }

        .info-card .nro-ot {
            font-size: 1.6rem;
            font-weight: 700;
            margin-left: 10px;
        }
</style>

<div class="mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card info-card border-primary text-center">
                <div class="card-body d-flex justify-content-center align-items-center">

                    <span class="titulo text-primary">
                        Listado de entregas
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toolbar mb-3">
    <input type="text" class="form-control me-2" placeholder="Buscar medio de pago..."
           @bind="search" @bind:event="oninput" style="max-width:280px" />

    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="chkEntregado" @bind="filtroEntregado" />
        <label class="form-check-label" for="chkEntregado">Entregado</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="chkNoEntregado" @bind="filtroNoEntregado" />
        <label class="form-check-label" for="chkNoEntregado">No entregado</label>
    </div>

    <button class="btn btn-primary ms-3" @onclick="@(() => Nav.NavigateTo("/entregas/nueva"))">
        + Agregar entrega
    </button>
    </div>


@if (loading)
{
    <div class="alert alert-info">Cargando entregas...</div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">Error: @error</div>
}
else if (entregas is null || !entregas.Any())
{
    <div class="alert alert-warning">No hay entregas registradas.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nro de la orden</th>
                <th>Nombre de la orden</th>
                <th>Fecha de entrega de la orden</th>
                <th>Entregado</th>
                <th>Medio de pago</th>
                <th>Eliminar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Filtrar(entregas))
            {
   
                <tr>
                    <td>@e.NroOT</td>
                    <td>@e.NombreOrden</td>

                    <td>
                        <input type="date"
                               value="@e.FechaEntrega?.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.AddYears(-5).ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.AddYears(5).ToString("yyyy-MM-dd")"
                               disabled="@e.Entregado"
                               @onchange="async ex => await CambiarFechaEntrega(e.Id, ex.Value?.ToString())" />
                    </td>

                    <td>@(e.Entregado ? " Sí" : "No" )
                        <input type="checkbox"
                               class="form-check-input"
                               checked="@e.Entregado"
                               disabled="@e.Entregado"
                               @onchange="async args => await CambiarEstadoEntrega(e.Id, args.Value is true)" />
                       </td>
                 

                    <td>@e.MedioDePago</td>
                    <td>

                        <button class="btn btn-sm btn-danger"
                                disabled="@(isDeletingNroOT == e.NroOT)"
                                @onclick="() => MenuDelete(e.NroOT)">
                            🗑
                        </button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<ConfirmationModal @ref="confirmationModal" OnConfirm="ConfirmDelete" />


@code 
{
    private HashSet<int> estadosEnProceso = new();

    public class ActualizarFechaDTO
    {
        public DateTime Fecha { get; set; }
    }

    private async Task CambiarFechaEntrega(int entregaId, string? nuevaFecha)
    {
        if (string.IsNullOrWhiteSpace(nuevaFecha))
            return;

        if (!DateTime.TryParse(nuevaFecha, out var fecha))
            return;

        var dto = new ActualizarFechaDTO
        {
            Fecha = fecha
        };

        var response = await Http.PatchAsJsonAsync(
            $"api/Ordenes/{entregaId}/FechaEntrega",
            dto);

        if (response.IsSuccessStatusCode)
        {
            var entregaActualizada =
                await response.Content.ReadFromJsonAsync<EntregaDetalleDTO>();

            if (entregaActualizada != null && entregas != null)
            {
                var index = entregas.FindIndex(e => e.Id == entregaActualizada.Id);

                if (index >= 0)
                {
                    entregas[index] = entregaActualizada;
                    StateHasChanged();
                }
            }
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await confirmationModal.ShowInfoAsync(error);
        }
    }


    private async Task CambiarEstadoEntrega(int id, bool nuevoEstado)
    {
        if (estadosEnProceso.Contains(id))
            return;

        estadosEnProceso.Add(id);

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/Entregas/ActualizacionPorEstado?Id={id}&Entregado={nuevoEstado}",
                new { });

            if (response.IsSuccessStatusCode)
            {
                var entregaActualizada =
                    await response.Content.ReadFromJsonAsync<EntregaDetalleDTO>();

                if (entregaActualizada != null)
                {
                    var index = entregas?.FindIndex(e => e.Id == id);

                    if (index is >= 0)
                        entregas![index.Value] = entregaActualizada;
                }
            }
            else
            {
                await confirmationModal.ShowInfoAsync("No se pudo actualizar el estado de la entrega");
            }
        }
        finally
        {
            estadosEnProceso.Remove(id);
        }
    }



    private ConfirmationModal? confirmationModal;
    private List<EntregaDetalleDTO>? entregas;

    private bool loading = true;
    private string? error;

    private string search = string.Empty;
    private bool filtroEntregado = true;
    private bool filtroNoEntregado = true;

    private int? isDeletingNroOT = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarEntregas();
    }

  

    private async Task CargarEntregas()
    {
        try
        {
            entregas =
                await Http.GetFromJsonAsync<List<EntregaDetalleDTO>>("api/Entregas");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        loading = false;
    }


    private async Task CambiarEstado(EntregaDetalleDTO e)
    {
        if (estadosEnProceso.Contains(e.Id))
            return;

        estadosEnProceso.Add(e.Id);
        StateHasChanged(); // bloquea inmediatamente

        try
        {
            var nuevoEstado = !e.Entregado;

            var response = await Http.PutAsJsonAsync(
                $"api/Entregas/ActualizacionPorEstado?Id={e.Id}&Entregado={nuevoEstado}",
                new { });

            if (response.IsSuccessStatusCode)
            {
                e.Entregado = nuevoEstado;
            }
            else
            {
                await confirmationModal.ShowInfoAsync("No se pudo actualizar el estado");
            }
        }
        catch
        {
            await confirmationModal.ShowInfoAsync("Error en el servidor");
        }
        finally
        {
            estadosEnProceso.Remove(e.Id);
            StateHasChanged();
        }
    }

    private IEnumerable<EntregaDetalleDTO> Filtrar(
        IEnumerable<EntregaDetalleDTO> lista)
    {
        var query = lista;

        if (!string.IsNullOrWhiteSpace(search))
            query = query.Where(e =>
                e.MedioDePago.Contains(search,
                StringComparison.OrdinalIgnoreCase));

        if (!filtroEntregado)
            query = query.Where(e => !e.Entregado);

        if (!filtroNoEntregado)
            query = query.Where(e => e.Entregado);

        return query;
    }

    private async Task MenuDelete(int nroOT)
    {
        if (confirmationModal != null)
        {
            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar la entrega N° {nroOT}?",
                nroOT);
        }
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmed && confirmationModal != null)
        {
            await Eliminar(confirmationModal.CurrentItemId);
        }
        else
        {
            if (confirmationModal != null)
                await confirmationModal.HideAsync();
        }
    }

    private async Task Eliminar(int nroOT)
    {
        try
        {
            isDeletingNroOT = nroOT;

            if (confirmationModal != null)
                await confirmationModal.HideAsync();

            var resp = await Http.DeleteAsync($"api/Entregas/{nroOT}");

            if (resp.IsSuccessStatusCode)
            {
                entregas = entregas?
                    .Where(e => e.NroOT != nroOT)
                    .ToList();

                await confirmationModal.ShowInfoAsync("Entrega eliminada exitosamente");

            }
            else
            {
                var errorContent = await resp.Content.ReadAsStringAsync();

                
                await confirmationModal.ShowInfoAsync("No se pudo eliminar la entrega");
            }
        }
        catch (Exception ex)
        {
            await confirmationModal.ShowInfoAsync("Error en el servidor");
        }
        finally
        {
            isDeletingNroOT = null;
        }
    }
}

<style>
    .toolbar {
        display: flex;
        align-items: center;
        gap: .5rem;
    }
</style>