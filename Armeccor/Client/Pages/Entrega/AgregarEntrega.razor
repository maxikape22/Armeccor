@page "/entregas/nueva"
@using DTO.ObjetosDTO
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        padding: 1.5rem;
    }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        }

        .info-card .titulo {
            font-size: 1.4rem;
            font-weight: 600;
        }

        .info-card .nro-ot {
            font-size: 1.6rem;
            font-weight: 700;
            margin-left: 10px;
        }
</style>

   
<div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card info-card border-primary text-center">
                <div class="card-body d-flex justify-content-center align-items-center">

                    <span class="titulo text-primary">
                        Registrar entrega
                    </span>
                </div>
            </div>
        </div>
</div>


@if (OrdenDetalleDTOs is null)
{
    <div class="alert alert-info">Cargando órdenes...</div>
}
else
{
    <EditForm Model="Entrega" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre de la orden</label>
            <select class="form-select" @bind="Entrega.IdOrden">
                <option value="">-- Seleccione una orden --</option>
                @* @foreach (var orden in OrdenDetalleDisponibles)
                {
                    <option value="@orden.Id">
                        @(orden.FechaEntrega.HasValue ?              
                        orden.FechaEntrega.Value.ToString("dd/MM/yyyy") : "")
                    </option>                    
                } *@

               @*  @foreach (var orden in OrdenDetalleDisponibles)
                {
                    <option value="@orden.Id">
                        @(orden.NombreOrden)
                    </option>
                } *@

                @foreach (var medio in OrdenDetalleDisponibles)
                {
                    <option value="@medio.Id">@medio.NombreOrden</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Valor de entrega por defecto</label>
            <InputSelect @bind-Value="Entrega.Entregado" class="form-select">
                <option value="false" disabled>No
                </option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Seleccione medio de pago</label>
            <select class="form-select" @onchange="OnMedioChange">
                <option value="0">-- Seleccione medio --</option>
                @foreach (var medio in MediosDePago)
                {
                    <option value="@medio.Id">@medio.Nombre_Medio</option>
                }
                <option value="-1">Otro medio...</option>
            </select>
        </div>

        @if (otroMedio)
        {
            <div class="mb-3">
                <label class="form-label">Ingrese nuevo medio</label>
                <input class="form-control" @bind="nuevoMedioNombre" />
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-success" type="submit">Guardar</button>
            <button class="btn btn-secondary" type="button" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

<ConfirmationModal @ref="confirmationModal" />

@code
{
    private ConfirmationModal? confirmationModal;

    private bool isLoading = true;
    private List<Armeccor.Datos.Entidades.MedioDePago> MediosDePago = new();
    private List<OrdenDetalleDTO> OrdenDetalleDTOs = new();
    private List<OrdenDetalleDTO> OrdenDetalleDisponibles = new();
    private CrearEntregaDTO Entrega = new CrearEntregaDTO();
    private bool otroMedio = false;
    private string nuevoMedioNombre = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            MediosDePago = await Http.GetFromJsonAsync<List<MedioDePago>>("api/MediosDePago") ?? new List<Armeccor.Datos.Entidades.MedioDePago>();
            var ordenes = await Http.GetFromJsonAsync<List<OrdenDetalleDTO>>("api/Ordenes/LISTADO");
            OrdenDetalleDisponibles = ordenes ?? new List<OrdenDetalleDTO>();
        }
        catch (Exception ex)
        {
            //await JS.InvokeVoidAsync("alert", $"Error cargando datos: {ex.Message}");
            await confirmationModal.ShowInfoAsync("Error al cargar las entregas");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnMedioChange(ChangeEventArgs e)
    {
        if (int.TryParse(e?.Value?.ToString(), out var v))
        {
            if (v == -1)
            {
                otroMedio = true;
                Entrega.MedioDePagoId = 0;
            }
            else
            {
                otroMedio = false;
                Entrega.MedioDePagoId = v;
                nuevoMedioNombre = string.Empty;
            }
        }
    }

    private async Task Guardar()
    {
        // Si eligió "otro medio" y no puso nombre -> error
        if (otroMedio)
        {
            if (string.IsNullOrWhiteSpace(nuevoMedioNombre))
            {
                //await JS.InvokeVoidAsync("alert", "Ingrese el nombre del nuevo medio de pago.");
                await confirmationModal.ShowInfoAsync("Ingrese el medio de pago primero");
                return;
            }
            Entrega.NuevoMedio = nuevoMedioNombre;
            Entrega.MedioDePagoId = 0;
        }

        // Validaciones básicas
        if (Entrega.IdOrden <= 0)
        {
            //await JS.InvokeVoidAsync("alert", "Debe seleccionar una orden.");
            await confirmationModal.ShowInfoAsync("Debe seleccionar una orden");
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/Entregas", Entrega);
        if (resp.IsSuccessStatusCode)
        {
            // await JS.InvokeVoidAsync("alert", "Entrega guardada.");
            // Nav.NavigateTo("/Entregas");
            if (confirmationModal != null)
            {
                await confirmationModal.ShowInfoAsync(
                    "✅ Entrega registrada correctamente.",
                    async () =>
                    {
                        Nav.NavigateTo("/Entregas");
                        await Task.CompletedTask;
                    });
            }
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            //await JS.InvokeVoidAsync("alert", $"Error al guardar: {msg}");
            await confirmationModal.ShowInfoAsync("Error al guardar la entrega");
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/Entregas");
    }
}
