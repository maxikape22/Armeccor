@page "/entregas/nueva"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Nueva entrega</h3>

@if (OrdenDetalleDTOs is null)
{
    <div class="alert alert-info">Cargando órdenes...</div>
}
else
{
    <EditForm Model="Entrega" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Fecha de entrega</label>
            <select class="form-select" @bind="Entrega.IdOrden">
                <option value="">-- Seleccione una fecha de entrega --</option>
                @foreach (var orden in OrdenDetalleDisponibles)
                {
                    <option value="@orden.Id">
                        @(orden.FechaEntrega.HasValue ?                                     
                        orden.FechaEntrega.Value.ToString("dd/MM/yyyy") : "")
                    </option>
                }
            </select>
        </div>
@* 
        <div class="mb-3">
            <label for="areaSelect" class="form-label">Área</label>
            <select id="areaSelect" class="form-select" @bind="nuevaArea.AreaId">
                <option value="">-- Seleccione un área --</option>
                @foreach (var area in areasDisponibles)
                {
                    <option value="@area.Id">@area.NombreArea</option>
                }
            </select>
        </div> *@

        <div class="mb-3">
          @*    <label class="form-label">Entregado</label>
            <select class="form-select" @bind="entrega.Entregado">
                <option value="true">Sí</option>
                <option value="false">No</option>
            </select>  *@

            <InputSelect @bind-value="Entrega.Entregado">
                <option value="">-- entregado --</option>
                <option value="true">Sí</option>
                <option value="false">No</option>
            </InputSelect> 
        </div>

        <div class="mb-3"> 
            <InputSelect @bind-Value="Entrega.MedioDePago">
                @foreach (var MedioDePago in MediosDePago)
                {
                    <option value="@MedioDePago">@MedioDePago</option>
                }
            </InputSelect>
        </div>

        <button class="btn btn-success" type="submit">Guardar</button>
        <button class="btn btn-secondary ms-2" @onclick="@(() => Cancelar())">Cancelar</button>
    </EditForm>

@code 
{
    private List<string> MediosDePago = new List<string>
    {
        "Tarjeta",
        "Efectivo",
        "MercadoPago",
        "Transferencia",
        "Criptomonedas"
    };


    private CrearEntregaDTO Entrega = new();
    private List<OrdenDTO>? Ordenes;
    private List<OrdenDetalleDTO> OrdenDetalleDTOs = new List<OrdenDetalleDTO>();
    private OrdenDetalleDTO OrdenDetalleDTO = new OrdenDetalleDTO();
    [Parameter] public int OrdenId { get; set; }
    private List<OrdenDetalleDTO> OrdenDetalleDisponibles = new List<OrdenDetalleDTO>();



    protected override async Task OnInitializedAsync()
    {
        OrdenDetalleDisponibles = await Http.GetFromJsonAsync<List<OrdenDetalleDTO>>("api/Ordenes");
        Entrega.MedioDePago = "Tarjeta";
        OrdenDetalleDisponibles = OrdenDetalleDisponibles
            .Where(o => !o.FechaEntrega.Equals(null)) // Filtrar solo las órdenes sin entrega realizada
            .ToList();
    }

    public void Cancelar()    
    {
        Nav.NavigateTo("/api/Entregas");
    }

    private async Task Guardar()
    {
        var resp = await Http.PostAsJsonAsync("/api/Entregas", Entrega);
        if (resp.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/api/Entregas");
        }
    }
 }    
}