<div class="buscador-contenedor">
    <input class="input-buscar" @bind="filtro" placeholder="Buscar por nombre..." />
    <button class="btn-buscar" @onclick="Buscar">Buscar</button>
    <button class="btn-limpiar" @onclick="LimpiarFiltro">Limpiar</button>
    <button class="btn-nueva" @onclick="NuevaArea">+ Nueva Área</button>
</div>

<div class="carousel-wrapper">
    <div class="carousel-container">
        <div id="carousel" class="carousel">
            @foreach (var area in areasFiltradas)
            {
                <div class="carousel-item">
                    <h3>@area.NombreArea</h3>
                    <div class="btn-box">
                        <button class="btn-edit" @onclick="() => Editar(area.Id)">
                            Editar                          
                        </button>
                        <button class="btn-delete" @onclick="() => ConfirmarEliminar(area.Id,area.NombreArea)">
                            Eliminar                          
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <button class="nav-btn left" @onclick="Prev">&#10094;</button>
    <button class="nav-btn right" @onclick="Next">&#10095;</button>
</div>

@code 
{
    private List<AreaListaDTO> areas = new();
    private List<AreaListaDTO> areasFiltradas = new();
    private string filtro = "";

    protected override async Task OnInitializedAsync()
    {
        areas = await Http.GetFromJsonAsync<List<AreaListaDTO>>("api/Areas") ?? new();
        areasFiltradas = areas.OrderBy(z=>z.Id).ToList();
    }

    private async Task ConfirmarEliminar(int id, string nombre)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar el área: {nombre}?");
        if (!ok) return;
        await Eliminar(id);
        await OnInitializedAsync();
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(filtro))
            areasFiltradas = areas;
        else
            areasFiltradas = areas
                .Where(x => x.NombreArea.Contains(filtro, StringComparison.OrdinalIgnoreCase))
                .OrderBy(z=>z.Id)
                .ToList();

        // InvokeAsync(async () =>
        // {
        //     await Task.Delay(1);
        //     await JS.InvokeVoidAsync("renderCarousel");
        // });

        await InvokeAsync(async () =>    
        {
            await JS.InvokeVoidAsync("renderCarousel");
            await JS.InvokeVoidAsync("centerByText", filtro);
        });

    }

    private void NuevaArea()
    {
        Navigation.NavigateTo("/api/Areas/AgregarArea");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/api/Areas/Editar/{id}");
    }

    private async Task Eliminar(int id)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/Areas/{id}");
            if (resp.IsSuccessStatusCode)
            {
                areas.RemoveAll(a => a.Id == id);
                await JS.InvokeVoidAsync("alert", "Área eliminada.");
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Console.WriteLine($"Error al eliminar área: {resp.StatusCode} - {body}");
                await JS.InvokeVoidAsync("alert", $"Error al eliminar área: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar área: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error al eliminar área. Ver consola.");
        }
    }

    private async Task Next()
    {
        await JS.InvokeVoidAsync("nextCarousel");
    }

    private async Task Prev()
    {
        await JS.InvokeVoidAsync("prevCarousel");
    }

    private async Task LimpiarFiltro()
    {
        filtro = "";
        areasFiltradas = areas;
        await InvokeAsync(async () =>    
        {
            await JS.InvokeVoidAsync("renderCarousel");
        });
    }
}
