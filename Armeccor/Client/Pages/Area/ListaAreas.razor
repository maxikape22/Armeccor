<script>
    let angle = 0;

    function renderCarousel() {
        const items = document.querySelectorAll(".carousel-item");
        if (items.length === 0) return;

        const fixedSlice = 1000;   // separación fija (tu valor)
        const radius = 500;        // distancia desde el centro (tu valor)

        const total = items.length;
        const offset = -((total - 1) / 2); // distribución simétrica

        const isSingle = total === 1;

        items.forEach((item, i) => {
            const rotation = isSingle ? 0 : fixedSlice * (i + offset) + angle;
            const rad = rotation * (Math.PI / 180);

            const x = Math.sin(rad) * radius;
            const z = Math.cos(rad) * radius;

            item.style.transform = `
                translateX(${x}px)
                translateZ(${z}px)
                translateY(40px)
                rotateY(${rotation}deg)
            `;
        });
    }

    function nextCarousel() {
        const step = 10; // mantengo tu paso
        angle -= step;
        renderCarousel();
    }

    function prevCarousel() {
        const step = 10;
        angle += step;
        renderCarousel();
    }

    // Centrar por índice sin cambiar estructura ni crear deformaciones
    function centerByIndex(index) {
        const items = document.querySelectorAll(".carousel-item");
        if (items.length === 0) return;

        const fixedSlice = 1000;
        const total = items.length;
        const offset = -((total - 1) / 2);

        // Ajuste de ángulo para que el ítem elegido quede con rotación 0 (centro visual)
        angle = -fixedSlice * (index + offset);
        renderCarousel();
    }

    // Centrar por texto (ej: nombre en h3), estable y sin efectos colaterales
    function centerByText(text) {
        const items = Array.from(document.querySelectorAll(".carousel-item"));
        if (items.length === 0) return;
        const query = (text || "").toLowerCase();

        const idx = items.findIndex(el =>
            (el.textContent || "").toLowerCase().includes(query)
        );

        centerByIndex(idx >= 0 ? idx : 0);
    }

    // Inicialización
    window.addEventListener("load", renderCarousel);

    // Exponer para Blazor
    window.renderCarousel = renderCarousel;
    window.nextCarousel = nextCarousel;
    window.prevCarousel = prevCarousel;
    window.centerByIndex = centerByIndex;
    window.centerByText = centerByText;
</script>




