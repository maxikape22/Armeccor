    private ConfirmationModal? confirmationModal;
    private int? isDeletingId = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstantes();
    }

    private async Task CargarEstantes()
    {
        estantes = await Http.GetFromJsonAsync<List<EstanteDTO>>("api/Estantes") ?? new();
    }

    // ==============================
    // MODAL
    // ==============================

    private async Task MenuDelete(int id)
    {
        if (confirmationModal != null)
        {
            var estante = estantes.FirstOrDefault(e=>e.Id == id);
            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar el estante: {estante.Codigo}?",
                id);
        }
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmed && confirmationModal != null)
        {
            await Eliminar(confirmationModal.CurrentItemId);
        }
        else
        {
            if (confirmationModal != null)
                await confirmationModal.HideAsync();
        }
    }

