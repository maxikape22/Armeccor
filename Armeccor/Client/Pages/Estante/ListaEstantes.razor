@page "/Estantes"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3 class="mb-4">📦 Estantes</h3>

<style>
    .estante-card {
        border-radius: 16px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.18);
        transition: all 0.25s ease;
        height: 100%;
        border-left: 8px solid transparent;
    }

        .estante-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 22px rgba(0,0,0,0.28);
        }

    .sin-stock {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border-left-color: #dc3545;
    }

    .con-stock {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border-left-color: #198754;
    }

    .estante-label {
        font-size: 0.75rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .estante-value {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .badge-stock {
        font-size: 0.75rem;
        padding: 0.35em 0.6em;
    }
</style>

@if (estantes == null)
{
    <p><em>Cargando estantes...</em></p>
}
else if (!estantes.Any())
{
    <p>No hay estantes registrados.</p>
}
else
{
    <div class="row g-4">
        @foreach (var e in estantes)
        {
            var claseStock = e.CantidadInsumo == 0 ? "sin-stock" : "con-stock";
            var textoStock = e.CantidadInsumo == 0 ? "Sin stock" : "Disponible";
            var badgeClass = e.CantidadInsumo == 0 ? "bg-danger" : "bg-success";

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card estante-card @claseStock">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="estante-value">@e.Codigo</div>
                            <span class="badge @badgeClass badge-stock">@textoStock</span>
                        </div>

                        <div class="mb-2">
                            <div class="estante-label">Descripción</div>
                            <div>@e.Descripcion</div>
                        </div>

                        <div class="mb-2">
                            <div class="estante-label">Insumo</div>
                            <div>@e.NombreInsumo</div>
                        </div>

                        <div class="mb-3">
                            <div class="estante-label">Cantidad</div>
                            <div class="estante-value">@e.CantidadInsumo</div>
                        </div>

                        <div class="mt-auto text-end">
                            <button class="btn btn-sm btn-danger"
                                    disabled="@(isDeletingId == e.Id)"
                                    @onclick="() => MenuDelete(e.Id)">
                                Eliminar
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

<button class="btn btn-success mt-4" @onclick="IrAgregar">
    ➕ Nuevo Estante
</button>

<ConfirmationModal @ref="confirmationModal"
                   OnConfirm="ConfirmDelete" />

@code
{
