    private async Task Eliminar(int id)
    {
        try
        {
            isDeletingId = id;

            var resp = await Http.DeleteAsync($"api/Estantes/{id}");

            if (resp.IsSuccessStatusCode)
            {
                estantes = estantes.Where(e => e.Id != id).ToList();

                if (confirmationModal != null)
                    await confirmationModal.ShowInfoAsync("✅ Estante eliminado correctamente.");
            }
            else
            {
                if (confirmationModal != null)
                    await confirmationModal.ShowInfoAsync("❌ No se pudo eliminar el estante.");
            }
        }
        catch (Exception ex)
        {
            if (confirmationModal != null)
                await confirmationModal.ShowInfoAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            isDeletingId = null;
            StateHasChanged();
        }
    }

    private void IrAgregar()
    {
        Navigation.NavigateTo("/Estantes/Agregar");
    }
}