@page "/VerDetallePedidoInsumo"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Net.Http.Json

<PageTitle>Detalles del pedido</PageTitle>

@* <button class="btn btn-primary ms-3" @onclick="@(() => Navigation.NavigateTo("/RegistrarPedidoDetalleInsumo"))">
    + Registrar detalle del pedido
</button> *@

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        padding: 1.5rem;
    }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        }

        .info-card .titulo {
            font-size: 1.4rem;
            font-weight: 600;
        }

        .info-card .nro-ot {
            font-size: 1.6rem;
            font-weight: 700;
            margin-left: 10px;
        }
</style>

<div class="mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card info-card border-primary text-center">
                <div class="card-body d-flex justify-content-center align-items-center">

                    <span class="titulo text-primary">
                        Listado de pedidos sobre insumos
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>


@if (detalles == null)
{
    <p>No se encontraron detalles del pedido</p>
}
else
{
    <!-- Etiqueta fija que se ve SIEMPRE al cargar la página -->
    <div class="d-flex justify-content-end mb-3">
        <label class="fw-bold text-danger fs-4">
            Estado: Enviado a proveedor
        </label>
    </div>


    <table class="table table-striped table-bordered mt-3">
        <thead class="table-light">
            <tr>
                <th>Nro de pedido</th>
                <th>Item</th>
                <th>Insumo insuficiente</th>
                <th>Cantidad</th>
                <th>Fecha de uso</th>
                <th>Nro de orden</th>
                <th>Recibido (Sí/No)</th>
                <th>Nombre del proveedor</th>
                <th>Estado</th>
                <th>Entrega parcial</th>
                <th>Entrega total</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in detalles)
            {
                <tr>
                    <td>@d.NroPedido</td>
                    <td>@d.Item</td>
                    <td>@d.NombreInsumoInsuficiente</td>

                    <td>
                        <input type="number"
                               class="form-control"
                               value="@d.Cantidad"
                               @onchange="async e => await ActualizarCantidad(d.Id, Convert.ToInt32(e.Value))" />
                    </td>
                    
                    
                    @*<td>@d.FechaUso.ToShortDateString()</td>*@

                    <td>
                        <input type="date"
                               class="form-control form-control-sm"
                               value="@d.FechaUso.ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.AddYears(2).ToString("yyyy-MM-dd")"
                               @onchange="async e => await CambiarFechaUso(d.Id, e.Value?.ToString())" />
                    </td>



                    <td>@d.NroOT</td>

                    <td>
                        <input type="checkbox"
                               checked="@d.EsSolicitado" disabled
                               @onchange="async e => await CambiarSolicitud(d.Id, ((ChangeEventArgs)e).Value is bool b && b)" />
                        <span class="ms-2">@((d.EsSolicitado) ? "Sí" : "No")</span>
                    </td>

                    <td>@d.NombreProveedor</td>
                    @*<td>@d.Estado</td>*@
                   @*  <select class="form-select form-select-sm"
                            value="@d.Estado"
                            @onchange="async e => await CambiarEstado(d.Id, e.Value.ToString())">
                        @foreach (var estado in EstadosDisponibles)
                        {
                            <option value="@estado">@estado</option>
                        }
                    </select> *@
                    <td>
                        @d.Estado
                        @* <span class="badge @GetEstadoClass(d.Estado)">
                            @d.Estado
                        </span> *@
                    </td>

                    <td>
                        <input type="checkbox" checked="@d.EntregaParcial" disabled
                        @onchange="async e => await CambiarEntregaParcial(d.Id, ((ChangeEventArgs)e).Value is bool b && b)" />
                        <span class="ms-2">@((d.EntregaParcial) ? "Sí" : "No")</span>
                    </td>

                    <td>
                        <input type="checkbox" checked="@d.EntregaTotal" disabled
                        @onchange="async e => await CambiarEntregaTotal(d.Id, ((ChangeEventArgs)e).Value is bool b && b)" />
                        <span class="ms-2">@((d.EntregaTotal) ? "Sí" : "No")</span>
                    </td>

                    @* <td style="min-width: 180px">
                        <select class="form-select form-select-sm"
                                value="@d.Estado"
                                @onchange="e => CambiarEstado(d.Id, e.Value.ToString())">
                            <option value="">Seleccione un estado</option>
                            <option value="Recibido">Recibido</option>
                            <option value="Solicitado">Solicitado</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Entrega parcial">Entrega parcial</option>
                            <option value="Entrega total">Entrega total</option>
                        </select>
                    </td> *@

                    <td class="action-cell" style="min-width: 220px">
                        <div class="dropdown">
                            <button class="dropdown-toggle btn btn-sm btn-secondary"
                                    type="button"
                                    aria-haspopup="true"
                                    aria-expanded="@(openedDropdownId == d.Id)"
                                    @onclick="() => ToggleDropdown(d.Id)">
                                <i class="fas fa-cogs"></i> Opciones
                            </button>

                            <div class="dropdown-menu @(openedDropdownId == d.Id ? "show" : "")">
                                <!-- Combo de estados -->
                                <div class="dropdown-item-text">
                                    <select class="form-select form-select-sm"
                                            value="@d.Estado"
                                            @onchange="e => CambiarEstado(d.Id, e.Value?.ToString())">
                                        <option value="">Seleccione un estado</option>
                                        <option value="Recibido">Recibido</option>
                                        <option value="Solicitado">Solicitado</option>
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="Entrega parcial">Entrega parcial</option>
                                        <option value="Entrega total">Entrega total</option>
                                    </select>
                                </div>

                                <div class="dropdown-divider"></div>

@* 
                                <div class="dropdown-divider"></div>

                                <div class="dropdown-item-text" @onclick:stopPropagation="true">

                                    <select class="form-select form-select-sm mb-2"
                                            @onchange="e => SeleccionarProveedor(d.Id, e.Value?.ToString())">

                                        <option value="">Seleccione proveedor</option>

                                        @foreach (var p in proveedores)
                                        {
                                            <option value="@p.Id">@p.Nombre</option>
                                        }

                                        <option value="0">Otro</option>
                                    </select>

                                    @if (d.MostrarInputProveedor)
                                    {
                                        <input class="form-control form-control-sm mb-2"
                                               placeholder="Ingrese proveedor"
                                               @bind="d.NuevoProveedor" />   
                                    }

                                    <button class="btn btn-sm btn-primary w-100"
                                            @onclick="() => GuardarProveedor(d.Id)">
                                        Guardar proveedor
                                    </button>

                                </div> *@

                                <div class="dropdown-divider"></div>

                                <div class="dropdown-item-text" @onclick:stopPropagation="true">
                                    <select class="form-select form-select-sm"
                                            @onchange="e => SeleccionarProveedor(d.Id, e.Value?.ToString())">

                                        <option value="">Seleccione proveedor</option>

                                        @foreach (var p in proveedores)
                                        {
                                            <option value="@p.Id">@p.Nombre</option>
                                        }

                                        <option value="0">Otro</option>
                                    </select>

                                    @if (mostrarInputProveedor)
                                    {
                                        <input class="form-control form-control-sm mt-2"
                                               placeholder="Ingrese proveedor"
                                               @bind="nuevoProveedorNombre" />

                                        <button class="btn btn-sm btn-primary mt-2"
                                                @onclick="() => GuardarProveedor(d.Id)">
                                            Guardar
                                        </button>
                                    }

                                </div>
                                
                               


                                <!-- Botón Editar -->
                                <button class="dropdown-item" @onclick="@(() =>                                  
                                    { IrAEditarPedidoDetallado(d.Id); CloseDropdown(); })">
                                    <i class="fas fa-edit"></i> Editar
                                </button>


                                <!-- Botón Eliminar -->
                                <button class="dropdown-item text-danger" @onclick="@(() => { MenuDelete(d.Id); CloseDropdown(); })">
                                    <i class="fas fa-trash-alt"></i> Eliminar
                                </button>


                            </div>
                        </div>
                    </td>


                    
                </tr>
            }
        </tbody>
    </table>
@*     <button class="btn btn-secondary mt-3" @onclick="Volver">Volver</button>
 *@
}

<ConfirmationModal @ref="confirmationModal" OnConfirm="ConfirmDelete" />

@code 
{
    private ConfirmationModal? confirmationModal;

    //Datos del pedido para mostrar en el menú desplegable

    private int? openedDropdownId;

    private void ToggleDropdown(int id)
    {
        if (openedDropdownId == id)
            openedDropdownId = null;
        else
            openedDropdownId = id;
    }

    private void CloseDropdown()
    {
        openedDropdownId = null;
    }

    public void IrAEditarPedidoDetallado(int id)
    {
        Navigation.NavigateTo($"/EditarItemPedidoDetalladoDTO/{id}");
    }

    //
    private async Task MenuDelete(int id)
    {
        if (confirmationModal != null)
        {
            var pedido = detalles.FirstOrDefault(a => a.Id == id);

            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar el pedido: {pedido.NombreInsumoInsuficiente}?",
                id);
        }
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmationModal != null)
        {
            var id = confirmationModal.CurrentItemId;

            await confirmationModal.HideAsync(); // 🔥 cerrar primero

            if (confirmed)
            {
                await EliminarPedido(id);
            }
        }
    }
    //
    private async Task EliminarPedido(int id)
    {
        var response = await Http.DeleteAsync($"api/PedidoDetalleInsumos/EliminacionLogicaEnVezDeFisica?id={id}");

        if (response.IsSuccessStatusCode)
        {
            //await JS.InvokeVoidAsync("alert", "Pedido eliminado correctamente.");
            await confirmationModal.ShowInfoAsync("El pedido fue eliminado correctamente");
            await OnInitializedAsync(); // Refrescar la lista después de eliminar
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            //await JS.InvokeVoidAsync("alert", $"Error al eliminar pedido: {error}");
            var pedido = detalles.FirstOrDefault(i=>i.Id == id);
            await confirmationModal.ShowInfoAsync($"Error al eliminar el pedido: {pedido.NombreInsumoInsuficiente}");
        }
    }

    //


    PedidoDetalleInsumoDTO Pedido = new PedidoDetalleInsumoDTO();

    //Estados
    private readonly List<string> EstadosDisponibles = new()
    {
        "Pendiente",
        "Solicitado",
        "Entrega Parcial",
        "Entrega Total"
    };

    [Parameter] public int idPedido { get; set; }
    List<PedidoDetalleInsumoDTO> detalles;

    //

    List<ProveedorDTO> proveedores = new();

    bool mostrarInputProveedor = false;
    string? nuevoProveedorNombre;

    private async Task SeleccionarProveedor(int idPedidoDetalleInsumo, string? value)
    {
        if (!int.TryParse(value, out int idProveedor))
            return;

        // Si eligió "Otro"
        if (idProveedor == 0)
        {
            mostrarInputProveedor = true;
            return;
        }

        if (idPedidoDetalleInsumo <= 0)
        {
            await confirmationModal.ShowInfoAsync("Detalle inválido.");
            return;
        }

        var resp = await Http.PostAsync(
            $"api/PedidoDetalleInsumos/AsignarProveedorDesdeDetalle?idPedidoDetalleInsumo={idPedidoDetalleInsumo}&idProveedor={idProveedor}",
            null);

        if (resp.IsSuccessStatusCode)
        {
            var msg = await resp.Content.ReadAsStringAsync();

            await confirmationModal.ShowInfoAsync(
                $"✅ {msg}",
                async () =>
                {
                    await OnInitializedAsync();
                });
        }
        else
        {
            var error = await resp.Content.ReadAsStringAsync();
            await confirmationModal.ShowInfoAsync($"❌ {error}");
        }
    }

    private async Task GuardarProveedor(int idPedidoDetalleInsumo)
    {
        // if (string.IsNullOrWhiteSpace(nuevoProveedorNombre))
        // {
        //     await confirmationModal.ShowInfoAsync("Ingrese el nombre del proveedor.");
        //     return;
        // }

        // if (idPedidoDetalleInsumo <= 0)
        // {
        //     await confirmationModal.ShowInfoAsync("Detalle inválido.");
        //     return;
        // }

        var resp = await Http.PostAsync(
            $"api/PedidoDetalleInsumos/AsignarProveedorDesdeDetalle?idPedidoDetalleInsumo={idPedidoDetalleInsumo}&nuevoProveedor={nuevoProveedorNombre}",
            null);

        if (resp.IsSuccessStatusCode)
        {
            var msg = await resp.Content.ReadAsStringAsync();

            await confirmationModal.ShowInfoAsync(
                $"✅ {msg}",
                async () =>
                {
                    nuevoProveedorNombre = null;
                    mostrarInputProveedor = false;
                    await OnInitializedAsync();
                });
        }
        else
        {
            var error = await resp.Content.ReadAsStringAsync();
            await confirmationModal.ShowInfoAsync($"❌ {error}");
        }
    }
    //



    protected override async Task OnInitializedAsync()
    {
        proveedores = await Http.GetFromJsonAsync<List<ProveedorDTO>>("api/Proveedores");

        try
        {
            detalles = await Http.GetFromJsonAsync<List<PedidoDetalleInsumoDTO>>("api/PedidoDetalleInsumos/ListarDetalleInsumos");
        }
        catch
        {
            //await JS.InvokeVoidAsync("alert", "Error al cargar los detalles del pedido.");
            await confirmationModal.ShowInfoAsync("Error al cargar los detalles del pedido");
        }

        EstadosDisponibles.ToList();
        StateHasChanged();

    }

    private async Task CambiarEstado(int detalleId, string nuevoEstado)
    {
        var response = await Http.PatchAsync(
            $"api/PedidoDetalleInsumos/Detalle/{detalleId}/Estado",
            JsonContent.Create(nuevoEstado));

        if (!response.IsSuccessStatusCode)
        {
            //await JS.InvokeVoidAsync("alert", "No se pudo actualizar el estado");
            await confirmationModal.ShowInfoAsync("No se pudo actualizar el estado del pedido");
            return;
        }

        // 🔄 refrescar visual
        var detalle = detalles.First(d => d.Id == detalleId);
        detalle.Estado = nuevoEstado;
        await OnInitializedAsync();
    }

    private string HoyMin => DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    private string HoyMax => DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd");

    private async Task CambiarFechaUso(int id, string nuevaFechaString)
    {
        if (DateTime.TryParse(nuevaFechaString, out var nuevaFecha))
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/PedidoDetalleInsumos/{id}/FechaUso",
                new { FechaUso = nuevaFecha });

            if (response.IsSuccessStatusCode)
            {
                var detalle = detalles.FirstOrDefault(x => x.Id == id);
                if (detalle != null)
                {
                    detalle.FechaUso = nuevaFecha;
                }
            }
        }
    }

    private async Task ActualizarCantidad(int idDetalle, int nuevaCantidad)
    {
        var response = await Http.PatchAsJsonAsync($"api/PedidoDetalleInsumos/{idDetalle}/ActualizarCantidad", nuevaCantidad);
        if (response.IsSuccessStatusCode)
        {
            var detalle = detalles.FirstOrDefault(d => d.Id == idDetalle);
            if (detalle != null)
                detalle.Cantidad = nuevaCantidad;
        }
    }

    private async Task CambiarEntregaTotal(int idDetalle, bool nuevoEstado)
    {
        var response = await Http.PatchAsJsonAsync($"api/PedidoDetalleInsumos/{idDetalle}/ActualizarEntregaTotal", nuevoEstado);
        if (response.IsSuccessStatusCode)
        {
            var detalle = detalles.FirstOrDefault(d => d.Id == idDetalle);
            if (detalle != null)
                detalle.EntregaTotal = nuevoEstado;
        }
    }

    private async Task CambiarEntregaParcial(int idDetalle, bool nuevoEstado)
    {
        var response = await Http.PatchAsJsonAsync($"api/PedidoDetalleInsumos/{idDetalle}/ActualizarEntregaParcial", nuevoEstado);
        if (response.IsSuccessStatusCode)
        {
            var detalle = detalles.FirstOrDefault(d => d.Id == idDetalle);
            if (detalle != null)
                detalle.EntregaParcial = nuevoEstado;
        }
    }

    private async Task CambiarSolicitud(int idDetalle, bool nuevoEstado)
    {
        var response = await Http.PatchAsJsonAsync($"api/PedidoDetalleInsumos/{idDetalle}/ActualizarSolicitud", nuevoEstado);
        if (response.IsSuccessStatusCode)
        {
            var detalle = detalles.FirstOrDefault(d => d.Id == idDetalle);
            if (detalle != null)
                detalle.EsSolicitado = nuevoEstado;
        }
    }

}
