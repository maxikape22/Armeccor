@page "/Ordenes"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject NavigationManager navigationManager
@using System.Net.Http.Json
@using System.Text.Json


<PageTitle>Órdenes</PageTitle>

<style>
    /* ====== Estilos (CSS puro) ====== */
    .container {
        max-width: 1200px;
        margin: 24px auto;
        padding: 18px;
        background: #ffffff;
        border-radius: 10px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        color: #222;
    }

    h2 {
        text-align: center;
        margin-bottom: 12px;
        color: #222;
    }

    .header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .header-left input {
            padding: 8px 10px;
            border-radius: 8px;
            border: 1px solid #d0d0d0;
            width: 320px;
        }

    .header-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .status-select {
        padding: 8px;
        border-radius: 8px;
        border: 1px solid #d0d0d0;
        background: white;
    }

    .btn-new-order {
        background: #0078d7;
        color: #fff;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn-new-order:hover {
            background: #005fa3;
        }

    /* Tabla */
    .order-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
        font-size: 0.95rem;
    }

        .order-table th, .order-table td {
            padding: 10px 12px;
            border: 1px solid #e6e6e6;
            text-align: left;
            vertical-align: middle;
        }

        .order-table th {
            background: #f7f7f7;
            font-weight: 600;
        }

    .dropdown {
        position: relative; /* importante para que el menú se posicione respecto a este contenedor */
    }

    .dropdown-menu {
        position: absolute;
        top: 100%;
        right: 0; /* despliega hacia la izquierda si querés: usa left: 0 */
        z-index: 1000;
        background-color: #fff;
        min-width: 220px;
        box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
        border-radius: 8px;
        padding: 6px 0;
        overflow: visible; /* evita que se corte el contenido */
    }


    /* Paginación - abajo a la izquierda */
    .pagination-container {
        display: flex;
        align-items: center;
        justify-content: flex-start; /* abajo a la izquierda */
        gap: 8px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

        .pagination-container .page-btn {
            padding: 7px 10px;
            border-radius: 8px;
            border: 1px solid #cfcfcf;
            background: #f5f5f5;
            cursor: pointer;
        }

            .pagination-container .page-btn:hover {
                background: #e8e8e8;
            }

            .pagination-container .page-btn.active {
                background: #0078d7;
                color: white;
                border-color: #005fa3;
                font-weight: 600;
            }

            .pagination-container .page-btn:disabled {
                background: #f0f0f0;
                color: #9a9a9a;
                cursor: not-allowed;
            }

    /* Info a la derecha dentro del contenedor de paginación */
    .pagination-info {
        margin-left: auto;
        color: #555;
        font-size: 0.95rem;
    }


    /* Estilo para el boton*/
    .btn-search {
        background: #0078d7;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        margin-left: 8px;
    }

        .btn-search:hover {
            background: #005fa3;
        }

</style>


<div class="main-container">
    <div class="content-area">
        <div class="header">
            <div class="header-left">
                <input type="text" placeholder="Filtrar orden" @bind="SearchText" />
                <button class="btn-search" @onclick="BuscarOrdenesFiltradas"><i class="fas fa-search"></i> Buscar</button>
                <button class="btn-clear-search" @onclick="LimpiarBusqueda"><i class="fas fa-times-circle"></i> Limpiar</button>
            </div>

            <h2>ÓRDENES</h2>

            <div class="header-right">
                <select @onchange="OnStatusChanged" class="status-select">
                    <option value="">Filtro por estado</option>
                    <option value="Abierta">Abierta</option>
                    <option value="Cerrada">Cerrada</option>
                    <option value="Cancelada">Cancelada</option>
                    <option value="Procesada">Procesada</option>
                    <option value="Iniciada">Iniciada</option>
                    <option value="Finalizada">Finalizada</option>
                </select>

                <button class="btn-new-order" @onclick="NavigateToNewOrder"><i class="fas fa-plus-circle"></i> Nueva orden</button>
            </div>
        </div>

        @if (isLoading)
        {
            <p><em>Cargando órdenes...</em></p>
        }
        else if (filteredOrders == null || !filteredOrders.Any())
        {
            <p>No se encontraron órdenes.</p>
        }
        else
        {
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Nº de OT</th>
                        <th>Nombre de la orden</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Fecha de inicio</th>
                        <th>Fecha pactada</th>
                        <th>Fecha de entrega</th>
                        <th>Cliente</th>
                        <th>Área actual</th>                                         
                        <th>Acción</th>                                            
                    </tr>
                </thead>
                <tbody>
                    @foreach (var orden in filteredOrders)
                    {
                        <tr>
                            <td>@orden.NroOT</td>
                            <td>@orden.NombreOrden</td>
                            <td>@orden.Descripcion</td>
                            <td>@orden.Estado</td>
                            <td>@orden.FechaInicio.ToShortDateString()</td>
                            <td>@orden.FechaPactada.ToShortDateString()</td>
                            <td>@(orden.FechaEntrega.HasValue? orden.FechaEntrega.Value.ToString("dd/MM/yyyy") : "Sin fecha de entrega")</td>
                            <td>@orden.NombreCliente</td>
                            <td>@orden.AreaActual</td>
                            <td>
                                <div class="dropdown">
                                    <button class="dropdown-toggle" type="button" aria-haspopup="true" aria-expanded="@(openedDropdownId == orden.Id)" @onclick="() => ToggleDropdown(orden.Id)">
                                        <i class="fas fa-cogs"></i>
                                    </button>

                                    <div class="dropdown-menu @(openedDropdownId == orden.Id ? "show" : "")">
                                        <div class="dropdown-item" style="cursor:default;">
                                            <i class="fas fa-edit"></i>
                                            <strong style="margin-left:6px;">Cambiar Estado</strong>
                                        </div>

                                        <select class="status-select-inline"
                                                @onchange="(e) => MenuChangeOrderStatusTo(orden.Id, orden, e.Value?.ToString())">
                                            <option value="">Seleccionar estado…</option>
                                            <option value="Abierta">Abierta</option>
                                            <option value="Cerrada">Cerrada</option>
                                            <option value="Cancelada">Cancelada</option>
                                            <option value="Procesada">Procesada</option>
                                            <option value="Iniciada">Iniciada</option>
                                            <option value="Finalizada">Finalizada</option>
                                        </select>

                                        <button class="dropdown-item" @onclick="() => MenuViewAreaDetails(orden.NroOT)"><i class="fas fa-cogs"></i> Ver áreas</button>
                                        <button class="dropdown-item" @onclick="() => MenuViewPlans(orden.NroOT)"><i class="fas fa-file-alt"></i> Ver planos</button>
                                        <button class="dropdown-item" @onclick="() => MenuViewSupplies(orden.Id)"><i class="fas fa-boxes"></i> Ver insumos</button>
                                        <button class="dropdown-item" @onclick="() => ImprimirOrden(orden.NroOT)"><i class="fas fa-file-pdf"></i> Imprimir orden</button>
                                        <button class="dropdown-item danger" disabled="@(isDeletingId == orden.Id)" @onclick="() => MenuDelete(orden.NroOT)">
                                            @(isDeletingId == orden.Id ? "Eliminando..." : "Eliminar")
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* --- MOVER la paginación FUERA de la tabla para evitar problemas de render/DOM --- *@
            <div class="pagination-container" role="navigation" aria-label="Paginación órdenes">
                <button class="page-btn" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">⟨ Anterior</button>

                @{
                    int maxButtons = 7;
                    int start = 1;
                    int end = totalPages;
                    if (totalPages > maxButtons)
                    {
                        int half = maxButtons / 2;
                        start = Math.Max(1, currentPage - half);
                        end = start + maxButtons - 1;
                        if (end > totalPages) { end = totalPages; start = end - maxButtons + 1; }
                    }
                }

                @for (int i = start; i <= end; i++)
                {
                    var pageIndex = i; // <-- COPIA LOCAL para evitar captura de la variable del bucle
                                       <button class="page-btn @(pageIndex == currentPage ? "active" : "")" @onclick="() => GoToPage(pageIndex)">
                                           @pageIndex
                                       </button>
                }

                <button class="page-btn" @onclick="NextPage" disabled="@(!CanGoNext)">Siguiente ⟩</button>

                <div class="pagination-info">Página @currentPage de @totalPages — Total: @totalRecords registros</div>
            </div>
        }
    </div>
</div>

<ConfirmationModal @ref="confirmationModal" OnConfirm="ConfirmDelete" />

@code
{
    private List<OrdenDetalleDTO> orders = new();
    private List<OrdenDetalleDTO> filteredOrders = new();
    private bool isLoading = true;
    private ConfirmationModal? confirmationModal;
    private int? isDeletingId = null;
    private int? openedDropdownId = null;
    private OrdenDetalleDTO DetalleDTO = new OrdenDetalleDTO();
    private int NroOT => DetalleDTO.NroOT;

    private string SearchText { get; set; } = string.Empty;
    private string SelectedStatus { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalRecords = 0;
    private const int pageSize = 4;
    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        await CargarOrdenes();
        DetalleDTO.NroOT = NroOT;
    }

    public class PaginacionOrdenDetalleDTO
    {
        public int TotalRegistros { get; set; }
        public int PaginaActual { get; set; }
        public int TamanoPagina { get; set; }
        public int TotalPaginas { get; set; }
        public List<OrdenDetalleDTO> Datos { get; set; }
    }


    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        SelectedStatus = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        //await CargarOrdenes(); // usamos el mismo método que consulta al servidor (texto + estado)
        await FiltrarPorEstado();
    }

    private async Task FiltrarPorEstado()
    {
        if (string.IsNullOrWhiteSpace(SelectedStatus))
        {
            await CargarOrdenes(); // limpiar filtro
            return;
        }

        var url = $"api/ordenes/FiltroPorEstado?estado={SelectedStatus}&pagina={currentPage}&tamanoPagina={pageSize}";
        var response = await Http.GetFromJsonAsync<RespuestaPaginada>(url);

        if (response != null)
        {
            filteredOrders = response.Datos.ToList();
            totalRecords = response.TotalRegistros;
            totalPages = response.TotalPaginas;
        }

        await InvokeAsync(StateHasChanged);
    }


    private async Task BuscarOrdenesFiltradas()
    {
        currentPage = 1;
        await CargarOrdenes();
    }

    private async Task LimpiarBusqueda()
    {
        SearchText = string.Empty;
        SelectedStatus = string.Empty;
        currentPage = 1;
        await CargarOrdenes();
    }

    private async Task CargarOrdenes()
    {
        isLoading = true;
        try
        {
            string term = Normalize(SearchText);
            // paso el estado también al endpoint que filtrará en servidor
            string url;
            if (string.IsNullOrWhiteSpace(term) && string.IsNullOrWhiteSpace(SelectedStatus))
            {
                url = $"api/Ordenes/Paginacion2?pagina={currentPage}&tamanoPagina={pageSize}";
            }
            else
            {
                url = $"api/Ordenes/FiltroPorNombreDescripcion2?texto={Uri.EscapeDataString(term)}&estado={Uri.EscapeDataString(SelectedStatus)}&pagina={currentPage}&tamanoPagina={pageSize}";
            }

            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            if (root.TryGetProperty("datos", out var datosEl))
                orders = JsonSerializer.Deserialize<List<OrdenDetalleDTO>>(datosEl.GetRawText(), options) ?? new();
            else
                orders = new();

            totalRecords = root.TryGetProperty("totalRegistros", out var totalEl) ? totalEl.GetInt32() : orders.Count;
            totalPages = root.TryGetProperty("totalPaginas", out var totalPagesEl) ? Math.Max(1, totalPagesEl.GetInt32()) : Math.Max(1, (int)Math.Ceiling(totalRecords / (double)pageSize));
            currentPage = root.TryGetProperty("paginaActual", out var pageEl) ? pageEl.GetInt32() : currentPage;

            // si además necesitás un filtro local (por seguridad), lo aplicamos sobre 'orders'
            ApplyEstadoFilter();

            // Aseguramos que Blazor re-renderice en el hilo UI
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar órdenes: " + ex.Message);
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar órdenes: {ex.Message}");
            orders = new();
            filteredOrders = new();
            totalRecords = 0;
            totalPages = 1;
            currentPage = 1;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string Normalize(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var formD = input!.ToUpperInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(formD.Length);
        foreach (var ch in formD)
        {
            var uc = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);
            if (uc != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(ch);
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }

    private void ApplyEstadoFilter()
    {
        if (orders == null)
        {
            filteredOrders = new();
            return;
        }

        string estado = Normalize(SelectedStatus);

        filteredOrders = orders
            .Where(o => string.IsNullOrWhiteSpace(estado) || Normalize(o.Estado) == estado)
            .ToList();
    }

    private void NavigateToNewOrder() => NavigationManager.NavigateTo("/ordenes/nueva");

    private async Task MenuChangeOrderStatusTo(int id, OrdenDetalleDTO orden, string? estado)
    {
        if (!string.IsNullOrWhiteSpace(estado))
        {
            await ChangeOrderStatusTo(id, orden, estado);
            await CargarOrdenes();
        }
        CloseDropdown();
    }

    private void MenuViewAreaDetails(int id)
    {
        NavigationManager.NavigateTo($"/AreasDetalleOrden/{id}");
        CloseDropdown();
    }

    private void MenuViewPlans(int id)
    {
        NavigationManager.NavigateTo($"/PlanoEnLaOrden/{id}");
        CloseDropdown();
    }

    private void MenuViewSupplies(int id)
    {
        NavigationManager.NavigateTo($"/ListadoInsumosOrden/{id}");
        CloseDropdown();
    }

    private void ImprimirOrden(int NroOT)
    {
        var pdfUrl = $"/api/Ordenes/GenerarPDF/{NroOT}";
        NavigationManager.NavigateTo(pdfUrl, forceLoad: true);
        CloseDropdown();
    }

    private async Task MenuDelete(int NroOT)
    {
        await DeleteOrder(NroOT);
        CloseDropdown();
    }

    private async Task PreviousPage()
    {
        if (!CanGoPrevious) return;
        currentPage--;
        await CargarOrdenes();
    }

    private async Task NextPage()
    {
        if (!CanGoNext) return;
        currentPage++;
        await CargarOrdenes();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        currentPage = page;
        await CargarOrdenes();
    }

    private void ToggleDropdown(int id) => openedDropdownId = openedDropdownId == id ? null : id;
    private void CloseDropdown() => openedDropdownId = null;

    // --- tus métodos ChangeOrderStatusTo, DeleteOrder, ConfirmDelete, etc.
    private async Task ChangeOrderStatusTo(int id, OrdenDetalleDTO currentOrden, string newStatus)
    {
        // mantén tu implementación (PUT) o usa la versión simplificada para pruebas
        var updateDto = new CrearOrdenDTO
        {
            NroOT = currentOrden.NroOT,
            NombreOrden = currentOrden.NombreOrden,
            Descripcion = currentOrden.Descripcion,
            Estado = newStatus,
            FechaInicio = currentOrden.FechaInicio,
            FechaPactada = currentOrden.FechaPactada,
            FechaEntrega = currentOrden.FechaEntrega,
            ClienteId = currentOrden.ClienteId,
            PlanoId = currentOrden.PlanoId
        };

        var response = await Http.PutAsJsonAsync($"api/Ordenes/{id}", updateDto);
        if (response.IsSuccessStatusCode)
        {
            var o = orders?.FirstOrDefault(x => x.Id == id);
            if (o is not null) o.Estado = newStatus;
            ApplyEstadoFilter();
            await JSRuntime.InvokeVoidAsync("alert", "Estado de la orden actualizado con éxito.");
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            await JSRuntime.InvokeVoidAsync("alert", $"Error al actualizar el estado: {response.StatusCode} - {errorContent}");
        }
    }

    private async Task DeleteOrder(int NroOT)
    {
        if (confirmationModal != null)
        {
            await confirmationModal.ShowAsync($"¿Está seguro que desea eliminar la orden {NroOT}?", NroOT);
        }
    }

    private void Cancelar()
    {
        navigationManager.NavigateTo("/api/ListaOrdenes");
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmed && confirmationModal != null)
        {
            await ExecuteDelete(confirmationModal.CurrentItemId);
        }
        else
        {
            Cancelar();
        }
    }

    private async Task ExecuteDelete(int NroOT)
    {
        try
        {
            isDeletingId = NroOT;
            if (confirmationModal != null) await confirmationModal.HideAsync();

            var response = await Http.DeleteAsync($"api/Ordenes/{NroOT}");
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Orden eliminada con éxito.");
                await CargarOrdenes();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Error al eliminar la orden: {response.StatusCode} - {errorContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ocurrió un error al intentar eliminar la orden: {ex.Message}");
        }
        finally
        {
            isDeletingId = null;
        }
    }
}