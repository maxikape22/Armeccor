@page "/api/Insumos/AgregarInsumo"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3>Agregar Nuevo Insumo</h3>

<div class="mb-3">
    <label>Nombre</label>
    <input class="form-control" @bind="insumo.Nombre" placeholder="Ingrese nombre del insumo" />
</div>

<div class="mb-3">
    <label>Detalle</label>
    <input class="form-control" @bind="insumo.Detalle" placeholder="Ingrese detalle del insumo" />
</div>

<div class="mb-3">
    <label>Cantidad Disponible</label>
    <input class="form-control" type="number" @bind="insumo.CantDisponible" />
</div>

<div class="mb-3">
    <label>Unidad de Medida</label>
    <select class="form-select" @bind="insumo.UnidadMedidaId">
        <option value="">-- Seleccione unidad --</option>
        @foreach (var u in unidades)
        {
            <option value="@u.Id">@u.Nombre (@u.Abreviatura)</option>
        }
    </select>
</div>

<div class="mb-3">
    <button class="btn btn-success me-2" @onclick="Guardar">Guardar</button>
    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
</div>

<ConfirmationModal @ref="confirmationModal" />


@code 
{
    private CrearInsumoDTO insumo = new CrearInsumoDTO();
    private List<UnidadMedidaDTO> unidades = new();
    private ConfirmationModal? confirmationModal;
    protected override async Task OnInitializedAsync()
    {
        unidades = await Http.GetFromJsonAsync<List<UnidadMedidaDTO>>("api/Insumos/Unidades");
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(insumo.Nombre))
        {
            //await JS.InvokeVoidAsync("alert", "El nombre del insumo es obligatorio.");
            await confirmationModal.ShowInfoAsync("El nombre del insumo es obligatorio");
            return;
        }

        try
        {
            var resp = await Http.PostAsJsonAsync("api/Insumos", insumo);
            if (resp.IsSuccessStatusCode)
            {
                // await JS.InvokeVoidAsync("alert", "Insumo agregado correctamente.");
                // Navigation.NavigateTo("/Insumos");
                if (confirmationModal != null)
                {
                    await confirmationModal.ShowInfoAsync(
                        "✅ Insumo registrado correctamente.",
                        async () =>
                        {
                            Navigation.NavigateTo("/Insumos/AgregarInsumo");
                            await Task.CompletedTask;
                        });
                }
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                //await JS.InvokeVoidAsync("alert", $"Error al agregar insumo: {resp.StatusCode} - {body}");
                await confirmationModal.ShowInfoAsync("Error al registrar el insumo");
            }
        }
        catch (Exception ex)
        {
            await confirmationModal.ShowInfoAsync("Error en el servidor al registrar insumo");
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/Insumos");
    }
}
