@page "/api/Insumos/Editar/{InsumoId:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        padding: 1.5rem;
    }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        }

        .info-card .titulo {
            font-size: 1.4rem;
            font-weight: 600;
        }

        .info-card .nro-ot {
            font-size: 1.6rem;
            font-weight: 700;
            margin-left: 10px;
        }
</style>


<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card info-card border-primary text-center">
            <div class="card-body d-flex justify-content-center align-items-center">

                <span class="titulo text-primary">
                    Editar insumo
                </span>
            </div>
        </div>
    </div>
</div>
<h1>@Edicion</h1>

<EditForm Model="insumo" OnValidSubmit="GuardarCambios">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>Detalle</label>
        <div>
            <InputText class="form-control" @bind-Value="@insumo.Detalle" />
            <ValidationMessage For="@(() => insumo.Detalle)" />
        </div>
    </div> 

    <button class="btn btn-primary" type="submit">Aceptar</button>  
    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>

</EditForm>

@code {
    [Parameter]
    public int InsumoId { get; set; }
    private string Edicion = string.Empty;

    private CrearInsumoDTO insumo = new CrearInsumoDTO();

    protected override async Task OnInitializedAsync()
    {
        await CargarInsumo();
    }

    private async Task CargarInsumo()
    {
        try
        {
            insumo = await Http.GetFromJsonAsync<CrearInsumoDTO>($"api/Insumos/{InsumoId}");
            if (insumo == null)
            {
                await JS.InvokeVoidAsync("alert", "No se encontró el insumo.");
                Navigation.NavigateTo("/Insumos");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar insumo: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error al cargar insumo. Revisar consola.");
            Navigation.NavigateTo("/Insumos");
        }
    }

    private async Task GuardarCambios()
    {
        var resp = await Http.PutAsJsonAsync<CrearInsumoDTO>($"api/Insumos/{InsumoId}", insumo);
        //Navigation.NavigateTo("/Insumos");
        Cancelar();
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/Insumos");
    }
}