<ConfirmationModal @ref="confirmationModal" OnConfirm="ConfirmDelete" />


@code 
{

    private ConfirmationModal? confirmationModal;
    private int? isDeletingId = null;

    private List<string> tipos = new() { "Masa", "Longitud", "Volumen", "Superficie", "Agrupacion" };

    //private List<string> tipos = new();

    private string tipoSeleccionado = "";

    private string _tipoSeleccionado
    {
        get => _tipoSeleccionado;
        set
        {
            _tipoSeleccionado = value;
            FiltrarUnidades(); // sin parámetro
        }
    }

    private List<UnidadMedida> todasUnidades = new();
    private List<UnidadMedida> unidadesFiltradas = new();
    private int unidadOrigenId;
    private int unidadDestinoId;


    private void FiltrarUnidades()
    {
        unidadesFiltradas = todasUnidades
            .Where(u => u.Tipo == tipoSeleccionado)
            .OrderBy(u => u.Nombre)
            .ToList();

        unidadOrigenId = unidadesFiltradas.FirstOrDefault()?.Id ?? 0;
        unidadDestinoId = unidadesFiltradas.FirstOrDefault()?.Id ?? 0;
    }

    private List<string> ObtenerUnidadesPorTipo(string tipo)
    {
        switch (tipo)
        {
            case "Masa":
                return new() { "Gramo", "Kilogramo", "Libra", "Tonelada" };

            case "Longitud":
                return new() { "Metro", "Centímetro", "Pulgada", "Pie", "Yarda" };

            case "Volumen":
                return new() { "Litro", "Mililitro", "Metro cúbico", "Centímetro cúbico" };

            case "Superficie":
                return new() { "Metro cuadrado", "Centímetro cuadrado", "Milímetro cuadrado", "Pie cuadrado" };

            case "Agrupacion":
                return new() { "Unidad", "Caja", "Paquete", "Bolsa", "Barra", "Perfil", "Planchuela", "Rollo" };

            default:
                return new();
        }
    }


    private async void OnTipoChanged(InsumoConConversionesDTO insumo, ChangeEventArgs e)
    {
        insumo.TipoDestino = e.Value?.ToString() ?? "";

        var unidades = await Http.GetFromJsonAsync<List<UnidadMedida>>(
            $"/api/Insumos/UnidadesDeMedidaSegunTipoAsociadosaUnidadesDeFiltradoPorCadaTipo?tipo={insumo.TipoDestino}"
        );


        //unidades origen
        insumo.UnidadesOrigen = unidades
            .Select(u => new UnidadDestinoItem
                {
                    Id = u.Id,
                    Nombre = u.Nombre,
                    Abreviatura = u.Abreviatura
                })
            .ToList();


        //unidades destino
        insumo.UnidadesDestino = unidades
            .Select(u => new UnidadDestinoItem
            {
                Id = u.Id,
                Nombre = u.Nombre,
                Abreviatura = u.Abreviatura
            })
            .ToList();

        insumo.UnidadOrigenId = insumo.UnidadesOrigen.FirstOrDefault()?.Id ?? 0;

        insumo.UnidadDestinoId = insumo.UnidadesDestino.FirstOrDefault()?.Id ?? 0;

        StateHasChanged();
    }




    private void ActualizarUnidadesDestino(InsumoConConversionesDTO insumo)
    {
        // Diccionario de tipos → unidades permitidas
        //var permitidas = ObtenerUnidadesPorTipo(insumo.TipoDestino);

        var permitidas = ObtenerUnidadesPorTipo(insumo.Tipo);

        //Unidad origen
        insumo.UnidadesOrigen = todasUnidades
      .Where(u => permitidas.Contains(u.Nombre)) //|| permitidas.Contains(u.Abreviatura))
      .Select(u => new UnidadDestinoItem
      {
          Id = u.Id,
          Nombre = u.Nombre,
          Abreviatura = u.Abreviatura
      })
      .OrderBy(u => u.Nombre)
      .ToList();


        //Unidad destino
        insumo.UnidadesDestino = todasUnidades
              .Where(u => permitidas.Contains(u.Nombre) || permitidas.Contains(u.Abreviatura))
              .Select(u => new UnidadDestinoItem
            {
                Id = u.Id,
                Nombre = u.Nombre,
                Abreviatura = u.Abreviatura
            })
              .OrderBy(u => u.Nombre)
              .ToList();

        insumo.UnidadOrigenId = insumo.UnidadesOrigen.FirstOrDefault()?.Id ?? 0;

        insumo.UnidadDestinoId = insumo.UnidadesDestino.FirstOrDefault()?.Id ?? 0;
    }

    private async Task Convertir(InsumoConConversionesDTO insumo)
    {
        var origenNombre = insumo.UnidadesOrigen
            .FirstOrDefault(u => u.Id == insumo.UnidadOrigenId)?.Nombre ?? "";

        var destinoNombre = insumo.UnidadesDestino
            .FirstOrDefault(u => u.Id == insumo.UnidadDestinoId)?.Nombre ?? "";

        var resp = await Http.GetFromJsonAsync<ConversionUnidadResultadoDTO>(
            $"/api/Insumos/ConvertirSoloTexto?insumoId={insumo.Id}" +
            $"&unidadOrigenNombre={Uri.EscapeDataString(origenNombre)}" +
            $"&unidadDestinoNombre={Uri.EscapeDataString(destinoNombre)}"
        );

        insumo.UnidadConvertidaTexto = resp?.UnidadConvertidaTexto ?? "No se pudo convertir";
        StateHasChanged();
    }





    private string Formatear(decimal valor) { if (valor == 0) return "0"; if (valor < 1 && valor > 0) return valor.ToString("0.####################"); return valor.ToString("0.##"); }
    //

    private List<InsumoConConversionesDTO>? insumos;
    private bool loading = true;
    private string? error;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        //await CargarInsumos();
        await CargarInsumos();
        todasUnidades = await Http.GetFromJsonAsync<List<UnidadMedida>>("api/Insumos/Unidades");
        foreach (var i in insumos ?? Enumerable.Empty<InsumoConConversionesDTO>()) 
        {
            i.TipoDestino = i.Tipo; ActualizarUnidadesDestino(i);
        }
    }

    private async Task CargarInsumos()
    {
        try
        {
            insumos = await Http.GetFromJsonAsync<List<InsumoConConversionesDTO>>(
                "api/Insumos/ConConversiones"
            );
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        loading = false;
    }

    private IEnumerable<InsumoConConversionesDTO> Filtrar(IEnumerable<InsumoConConversionesDTO> lista)
    {
        if (!string.IsNullOrWhiteSpace(search))
        {
            lista = lista.Where(i =>
                i.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return lista;
    }

    private void IrANuevoInsumo()
    {
        Nav.NavigateTo("/api/Insumos/AgregarInsumo");
    }

    private void IrAEditarInsumo(int id)
    {
        Nav.NavigateTo($"/api/Insumos/Editar/{id}");
    }

    private async Task ConfirmarEliminar(InsumoConConversionesDTO insumo)
    {
        var ok = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Desea eliminar el insumo \"{insumo.Nombre}\"?"
        );

        if (!ok) return;

        await Eliminar(insumo.Id);
    }

    private async Task Eliminar(int id)
    {
        var resp = await Http.DeleteAsync($"api/Insumos/{id}");
        if (resp.IsSuccessStatusCode)
        {
            //insumos = insumos?.Where(i => i.Id != id).ToList();
            if (confirmationModal != null)
            {
                await confirmationModal.ShowInfoAsync("✅ Insumo eliminado correctamente.");
                // "✅ Insumo eliminado correctamente.",
                // async () =>
                // {
                //     //Nav.NavigateTo("/Insumos");
                //     await OnInitializedAsync();
                // });
            }
            await CargarInsumos();
        }
        else
        {
            //await JS.InvokeVoidAsync("alert", "Error al eliminar el insumo");
            var insumo = insumos.FirstOrDefault(a=>a.Id == id);
            await confirmationModal.ShowInfoAsync($"Error al eliminar el insumo: {insumo.Nombre}");
        }
    }


    //
    private async Task MenuDelete(int id)
    {
        if (confirmationModal != null)
        {
            var insumo = insumos.FirstOrDefault(a => a.Id == id);

            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar el insumo: {insumo.Nombre}?",
                id);
        }
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmationModal != null)
        {
            var id = confirmationModal.CurrentItemId;

            await confirmationModal.HideAsync(); // 🔥 cerrar primero

            if (confirmed)
            {
                await Eliminar(id);
            }
        }
    }
    //
}
