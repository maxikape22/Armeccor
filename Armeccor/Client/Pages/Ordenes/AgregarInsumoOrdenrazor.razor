@page "/AgregarInsumosOrden/{NroOT:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
    }

        .info-card:hover {
            transform: translateY(-6px) scale(1.03);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        .info-card .card-title {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .info-card .card-text {
            font-size: 1.25rem;
            font-weight: 600;
        }
</style>

<div class="mb-4">
    <h3 class="mb-3 text-center text-primary fw-bold">Gestión de Insumos de la Orden</h3>

    <div class="row text-center">
        <div class="col-md-4 mb-3">
            <div class="card info-card border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Número de OT</h5>
                    <p class="card-text">@NroOT</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card info-card border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Nombre de la Orden</h5>
                    <p class="card-text">@nombreOrden</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card info-card border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Cliente</h5>
                    <p class="card-text">@nombreCliente</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="width: 48%;">
        <input class="form-control" placeholder="Buscar por nombre de insumo..." @bind="filtroNombre" />
        <button class="btn btn-primary" @onclick="BuscarPorNombre">Buscar</button>
    </div>
</div>

<h4>🧾 Stock General Seleccione la Cantidad que Desea Retirar </h4>

@if (InsumoDTO == null)
{
    <p><em>Cargando insumos...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cantidad Disponible</th>
                <th>Cantidad A Retirar</th>
                <th style="width:120px">Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (InsumoDTOFiltrados != null && InsumoDTOFiltrados.Any())
            {
                @foreach (var i in InsumoDTOFiltrados)
                {
                    <tr>
                        <td>@i.Nombre</td>
                        <td>@i.CantDisponible</td>
                        <td>
                            <InputNumber @bind-Value="i.CantidadARetirar" class="form-control" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" @onclick="() => AgregarInsumoAOrden(i)">
                                Agregar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center">No se encontraron insumos.</td></tr>
            }
        </tbody>
    </table>
}

<hr />

<h4>🧾 Insumos ya cargados en la orden</h4>

@if (InsumosEnOrden == null)
{
    <p><em>Cargando...</em></p>
}
else if (!InsumosEnOrden.Any())
{
    <p>No hay insumos cargados para esta orden.</p>
}
else
{
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Insumo</th>
                <th>Cantidad Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in InsumosEnOrden)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Cantidad</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CrearInsumoDTO> InsumoDTO = new();           // Lista completa de insumos
    private List<CrearInsumoDTO> InsumoDTOFiltrados = new(); // Lista filtrada
    private List<InsumoDetalleOrdenDTO> InsumosEnOrden = new(); // Insumos ya agregados a la orden
    private CrearInsumoDTO insumoDTO = new CrearInsumoDTO();
    private string filtroNombre = string.Empty;

    private string nombreOrden = "";
   
    private string nombreCliente = "";
    [Parameter] public int NroOT { get; set; }
    private int ordenId;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosOrden();

        // ordenId = NroOT;
        await Cargar();               // carga todos los insumos
        await CargarInsumosDeOrden(); // carga los insumos que ya están agregados a la orden
    }

    private async Task Cargar()
    {
        InsumoDTO = await Http.GetFromJsonAsync<List<CrearInsumoDTO>>("api/Insumos") ?? new();
        InsumoDTOFiltrados = InsumoDTO;
    }
    // Obtiene el nombre de la orden y el cliente desde el backend
    private async Task CargarDatosOrden()
    {
        try
        {
            var orden = await Http.GetFromJsonAsync<OrdenDetalleDTO>($"api/Ordenes/{NroOT}");
            if (orden != null)
            {
                NroOT = orden.NroOT;
                nombreOrden = orden.NombreOrden ?? "(sin nombre)";
                nombreCliente = orden.NombreCliente ?? "(sin cliente)";
                ordenId = orden.Id;
            }
        }
        catch
        {
            nombreOrden = "(error)";
            nombreCliente = "(error)";
        }
    }

    private void BuscarPorNombre()
    {
        if (string.IsNullOrWhiteSpace(filtroNombre))
        {
            InsumoDTOFiltrados = InsumoDTO;
        }
        else
        {
            InsumoDTOFiltrados = InsumoDTO
                .Where(i => i.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task AgregarInsumoAOrden(CrearInsumoDTO insumo)
    {
        if (insumo.CantidadARetirar == null || insumo.CantidadARetirar <= 0)
        {
            await JS.InvokeVoidAsync("alert", $"Debe ingresar una cantidad válida para {insumo.Nombre}");
            return;
        }

        var detalleOrden = new
        {
            OrdenId = ordenId,
            InsumoId = insumo.Id,
            Cantidad = insumo.CantidadARetirar
        };

        var resp = await Http.PostAsJsonAsync("api/Insumo_Detalle_Orden", detalleOrden);

        if (resp.IsSuccessStatusCode)
        {
            var resultado = await resp.Content.ReadFromJsonAsync<InsumoDetalleResponse>();

            if (resultado != null)
            {
                insumo.CantDisponible = resultado.InsumoActualizado.CantDisponible;
                insumo.CantidadARetirar = null;

                // 🔹 Recargar lista de insumos de la orden
                await CargarInsumosDeOrden();

                // await JS.InvokeVoidAsync("alert",
                //     $"Se agregó {resultado.DetalleOrden.Cantidad} de {insumo.Nombre} a la orden {ordenId}. Stock restante: {insumo.CantDisponible}");
            }
        }
        else
        {
            var error = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error: {error}");
        }
    }

    private async Task CargarInsumosDeOrden()
    {
        var insumos = await Http.GetFromJsonAsync<List<InsumoDetalleOrdenDTO>>(
            $"api/Insumo_Detalle_Orden/AgrupadosPorOrden/{ordenId}");

        InsumosEnOrden = insumos ?? new();
        StateHasChanged();
    }

    public class InsumoDetalleResponse
    {
        public InsumoDetalleOrdenDTO DetalleOrden { get; set; }
        public CrearInsumoDTO InsumoActualizado { get; set; }
    }
}
