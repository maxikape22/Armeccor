    private async Task GenerarPedido(
        int nroOt,
        string nombreInsumo,
        bool insuficiente)
    {
        //var url = $"api/Insumo_Detalle_Orden/GenerarPedidoDetallePorOT?nroOt={nroOt}&nombreInsumo={nombreInsumo}&insuficiente={insuficiente}";
        var url = $"api/Insumo_Detalle_Orden/GenerarPedidoDetallePorOT?nroOt={nroOt}&nombreInsumo={Uri.EscapeDataString(nombreInsumo)}&insuficiente={insuficiente}";


        var response = await Http.PostAsync(url, null);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", error);
            return;
        }

        await CargarInsumosDeOrden();
        await Cargar();

        //await JS.InvokeVoidAsync("alert", $"Pedido generado correctamente para la orden N°: {NroOT}.");
        await confirmationModal.ShowInfoAsync($"Pedido generado correctamente para la orden N°: {NroOT}.");
        //return response.Content;
    }


    //
    private async Task MenuDelete(int id)
    {
        if (confirmationModal != null)
        {
            var insumo = InsumosEnOrden.FirstOrDefault(a => a.Id == id);

            await confirmationModal.ShowAsync(
                $"¿Está seguro que desea eliminar el insumo: {insumo.Nombre}?",
                id);
        }
    }

    private async Task ConfirmDelete(bool confirmed)
    {
        if (confirmationModal != null)
        {
            var id = confirmationModal.CurrentItemId;

            await confirmationModal.HideAsync(); // 🔥 cerrar primero

            if (confirmed)
            {
                await Eliminar(id);
            }
        }
    }
