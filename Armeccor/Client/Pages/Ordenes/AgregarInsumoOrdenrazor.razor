@page "/AgregarInsumosOrden/{NroOT:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS


<ConfirmationModal @ref="confirmationModal" OnConfirm="ConfirmDelete" />

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
    }

        .info-card:hover {
            transform: translateY(-6px) scale(1.03);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        .info-card .card-title {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .info-card .card-text {
            font-size: 1.25rem;
            font-weight: 600;
        }
</style>

<div class="mb-4">
    <h3 class="mb-3 text-center text-primary fw-bold">Gestión de Insumos de la Orden</h3>

    <div class="row text-center">
        <div class="col-md-4 mb-3">
            <div class="card info-card border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Número de OT</h5>
                    <p class="card-text">@NroOT</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card info-card border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Nombre de la Orden</h5>
                    <p class="card-text">@nombreOrden</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card info-card border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Cliente</h5>
                    <p class="card-text">@nombreCliente</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="width: 48%;">
        <input class="form-control" placeholder="Buscar por nombre de insumo..." @bind="filtroNombre" />
        <button class="btn btn-primary" @onclick="BuscarPorNombre">Buscar</button>
    </div>
</div>

<h4>🧾 Stock General Seleccione la Cantidad que Desea Retirar </h4>

@if (InsumoDTO == null)
{
    <p><em>Cargando insumos...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cantidad Disponible</th>
                <th>Cantidad A Retirar</th>
                <th style="width:120px">Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (InsumoDTOFiltrados != null && InsumoDTOFiltrados.Any())
            {
                @foreach (var i in InsumoDTOFiltrados)
                {
                    <tr>
                        <td>@i.Nombre</td>
                        <td>@i.CantDisponible</td>
                        <td>
                            <InputNumber @bind-Value="i.CantidadARetirar" class="form-control" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" @onclick="() => AgregarInsumoAOrden(i)">
                                Agregar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center">No se encontraron insumos.</td></tr>
            }
        </tbody>
    </table>
}

<hr />




<h4>🧾 Insumos cargados en la orden</h4>

@if (InsumosEnOrden == null)
{
    <p><em>Cargando...</em></p>
}
else if (!InsumosEnOrden.Any())
{
    <p>No hay insumos cargados para esta orden.</p>
}
else
{
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Insumo</th>
                <th>Cantidad total</th>
                <th>Cantidad a descontar</th>
                <th>Cantidad a solicitar</th>
                <th>Estado</th>
                <th>Pedido</th>
                <th>Eliminar insumo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in InsumosEnOrden)
            {
                <tr class="@(item.Insuficiente ? "table-danger" : "")">
                    <td>@item.Nombre</td>
                    <td>@item.Cantidad</td>
                    <td>@item.CantidadDescontada</td>
                    <td>@item.CantidadPendiente</td>
                    <td>
                        @(item.Insuficiente ? "Insuficiente" : "Suficiente")
                       @*  @if (item.Insuficiente)
                        {
                            <span class="badge bg-danger">INSUFICIENTE</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        } *@
                    </td>
                    <td>
                       @*  <button class="btn btn-warning btn-sm"
                                disabled="@(!item.Insuficiente)"
                                @onclick="() => GenerarPedido(item)">
                            Generar Pedido
                        </button> 
 *@    
                        <button class="btn btn-warning btn-sm"
                                disabled="@(!item.Insuficiente)"
                                @onclick="() => GenerarPedido(
                                item.NroOT,
                                item.Nombre,                                 
                                item.Insuficiente)">                                            
                               Generar Pedido                                                                                                       
                            </button>
                    </td>


                    <td class="text-center">
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => MenuDelete(item.Id)">
                            Eliminar
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

<!-- ✅ ACÁ VA EL BOTÓN (SIEMPRE VISIBLE) -->
