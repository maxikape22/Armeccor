    //     // 🔴 SIEMPRE refrescar desde backend
    //     await Cargar();               // insumos generales
    //     await CargarInsumosDeOrden(); // insumos de la OT
    // }

    
    private async Task CargarInsumosDeOrden()
    {
        //DetalleOrden.NroOT = NroOT;
        //ordenDetalleDTO.NroOT = NroOT;
        var insumos = await Http.GetFromJsonAsync<List<InsumoDetalleOrdenDTO>>(
            $"api/Insumo_Detalle_Orden/AgrupadosPorOrden/{NroOT}");

        InsumosEnOrden = insumos ?? new();
        StateHasChanged();
    }


