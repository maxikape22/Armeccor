@page "/AgregarInsumosOrden/{NroOT:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3>Agregar Insumos a la Orden</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="width: 48%;">
        <input class="form-control" placeholder="Buscar por nombre de insumo..." @bind="filtroNombre" />
        <button class="btn btn-primary" @onclick="BuscarPorNombre">Buscar</button>
    </div>
    @*     <div>
        <button class="btn btn-success" @onclick="IrANuevoInsumo">+ Nuevo Insumo</button>
    </div> *@
</div>

@if (InsumoDTO == null)
{
    <p><em>Cargando insumos...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cantidad Disponible</th>
                <th>Cantidad A Retirar</th>
                <th style="width:120px">Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (InsumoDTOFiltrados != null && InsumoDTOFiltrados.Any())
            {
                @foreach (var i in InsumoDTOFiltrados)
                {
                    <tr>
                        <td>@i.Nombre</td>
                        <td>@i.CantDisponible</td>
                        <td>
                            <InputNumber @bind-Value="i.CantidadARetirar" class="form-control" />

                            @*                         <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => IrAEditarInsumo(i.Id)">
                                Editar
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarEliminar(i.Id)">
                                Eliminar
                            </button> *@
                        </td>
                        <td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" @onclick="() => AgregarInsumoAOrden(i)">
                                Agregar
                            </button>
                        </td>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3" class="text-center">No se encontraron insumos.</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CrearInsumoDTO> InsumoDTO = new();           // Lista completa
    private List<CrearInsumoDTO> InsumoDTOFiltrados = new(); // Lista filtrada
    private CrearInsumoDTO insumoDTO = new CrearInsumoDTO();
    private string filtroNombre = string.Empty;

    [Parameter] public int NroOT { get; set; }

    private int ordenId;

    protected override async Task OnInitializedAsync()
    {
        ordenId = NroOT; // ✅ el id viene desde la URL
        //$"Se agregó {resultado.DetalleOrden.Cantidad} de {insumo.Nombre} a la orden {ordenId}. Stock restante: {insumo.CantDisponible}");
        //detalle
        await Cargar();
    }

    private async Task Cargar()
    {
        InsumoDTO = await Http.GetFromJsonAsync<List<CrearInsumoDTO>>("api/Insumos") ?? new();
        InsumoDTOFiltrados = InsumoDTO;
    }

    private void BuscarPorNombre()
    {
        if (string.IsNullOrWhiteSpace(filtroNombre))
        {
            InsumoDTOFiltrados = InsumoDTO; // Restaurar lista completa
        }
        else
        {
            InsumoDTOFiltrados = InsumoDTO
                .Where(i => i.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // private int ordenId = 1; // 👈 Ejemplo: el id de la orden actual. Podés pasarlo como parámetro.

    private async Task AgregarInsumoAOrden(CrearInsumoDTO insumo)
    {
        if (insumo.CantidadARetirar == null || insumo.CantidadARetirar <= 0)
        {
            await JS.InvokeVoidAsync("alert", $"Debe ingresar una cantidad válida para {insumo.Nombre}");
            return;
        }

        // Preparar objeto con OrdenId, InsumoId y Cantidad
        var detalleOrden = new
        {
            OrdenId = ordenId,               // 👈 nuevo
            InsumoId = insumo.Id,
            Cantidad = insumo.CantidadARetirar
        };

        // Enviar al backend
        var resp = await Http.PostAsJsonAsync("api/Insumo_Detalle_Orden", detalleOrden);

        if (resp.IsSuccessStatusCode)
        {
            var resultado = await resp.Content.ReadFromJsonAsync<InsumoDetalleResponse>();

            if (resultado != null)
            {
                // Actualizar stock con lo que devuelve el backend
                insumo.CantDisponible = resultado.InsumoActualizado.CantDisponible;
                insumo.CantidadARetirar = null;

                // Forzar renderizado
                StateHasChanged();


                await JS.InvokeVoidAsync("alert",
                    $"Se agregó {resultado.DetalleOrden.Cantidad} de {insumo.Nombre} a la orden {ordenId}. Stock restante: {insumo.CantDisponible}");
            }
        }
        else
        {
            var error = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error: {error}");
        }
    }

    // DTO auxiliar para deserializar la respuesta
    public class InsumoDetalleResponse
    {
        public InsumoDetalleOrdenDTO DetalleOrden { get; set; }
        public CrearInsumoDTO InsumoActualizado { get; set; }
    }



