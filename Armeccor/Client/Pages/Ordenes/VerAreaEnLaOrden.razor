    private Dictionary<int, System.Timers.Timer> temporizadores = new();
    private Dictionary<int, bool> temporizadorActivo = new();
    private Dictionary<int, CancellationTokenSource> _ctsPorArea = new();

    private async Task ToggleTemporizador(AreaDetalleOrdenListaDTO area)
    {
        // Si ya existe un CTS, significa que está corriendo → detener
        if (_ctsPorArea.TryGetValue(area.Id, out var cts))
        {
            cts.Cancel();
            _ctsPorArea.Remove(area.Id);
            area.EstaCorriendo = false;
            area.CantidadADescontar = 1; // ✅ Reset también al detener manualmente

            // Avisar al backend que se detuvo
            await Http.PutAsJsonAsync(
                $"api/Area_Detalle_Orden/{area.Id}/Temporizador",
                new { Accion = "DETENER" }
            );

            StateHasChanged();
            return;
        }

        // Validación: tiempo > 0 y cantidad > 0
        if (area.Tiempo.TotalSeconds <= 0 || area.CantidadADescontar <= 0) return;

        area.EstaCorriendo = true;

        StateHasChanged();

        var cantidad = area.CantidadADescontar;
        var ctsNuevo = new CancellationTokenSource();
        _ctsPorArea[area.Id] = ctsNuevo;

        _ = Task.Run(async () =>
        {
            var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            var descontados = 0;

            while (await timer.WaitForNextTickAsync(ctsNuevo.Token))
            {
                // Llamada al backend: descontar 1 segundo
                await Http.PutAsJsonAsync(
                    $"api/Area_Detalle_Orden/{area.Id}/Temporizador",
                    new { Accion = "INICIAR", Delta = 1 }
                );

                // Actualización local defensiva
                if (area.Tiempo.TotalSeconds > 0)
                    area.Tiempo = area.Tiempo.Add(TimeSpan.FromSeconds(-1));

                await InvokeAsync(StateHasChanged);

                descontados++;

                // Corte: si ya descontó la cantidad pedida o llegó a cero
                if (descontados >= cantidad || area.Tiempo.TotalSeconds <= 0)
                {
                    area.EstaCorriendo = false;
                    area.CantidadADescontar = 1;

                    await Http.PutAsJsonAsync(
                        $"api/Area_Detalle_Orden/{area.Id}/Temporizador",
                        new { Accion = "DETENER" }
                    );

                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }

            timer.Dispose();
        }, ctsNuevo.Token);
    }


