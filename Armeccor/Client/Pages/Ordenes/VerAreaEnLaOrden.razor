@page "/AreasDetalleOrden/{NroOT:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web;


@* <h3>Áreas detalladas de la orden N°: @NroOT - con nombre de orden: @NombreOrden - del cliente:  @NombreCliente</h3> *@

<style>
    .info-card {
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
    }

        .info-card:hover {
            transform: translateY(-6px) scale(1.03);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        .info-card .card-title {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .info-card .card-text {
            font-size: 1.25rem;
            font-weight: 600;
        }
</style>

<div class="mb-4">
    <h3 class="mb-3 text-center text-primary fw-bold">Gestión de áreas de la orden</h3>

    <div class="row text-center">
        <div class="col-md-4 mb-3">
            <div class="card info-card border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Número de OT</h5>
                    <p class="card-text">@NroOT</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card info-card border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Nombre de la Orden</h5>
                    <p class="card-text">@NombreOrden</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card info-card border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Cliente</h5>
                    <p class="card-text">@NombreCliente</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="d-flex justify-content-between mb-3">
    <div>
        <label>Filtrar por estado:</label>
        <select class="form-select d-inline-block w-auto" @bind="filtroEstado">
            <option value="">Todos</option>
            <option value="Pendiente">Pendiente</option>
            <option value="Iniciado">Iniciado</option>
            <option value="Finalizado">Finalizado</option>
            <option value="Detenido">Detenido</option>
        </select>

        <label class="ms-3">
            <input type="checkbox" @bind="soloFinalizados" />
            Solo finalizados
        </label>
    </div>
    <button class="btn btn-danger" @onclick="() => AgregarArea(NroOT)">➕ Agregar Área</button>
</div>

@*
    creo que aca iria esa implementacion para tener la solapíta igual que Windows
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5></h5>
    <div>
        <label class="form-label me-2">Ordenar por:</label>
        <select class="form-select form-select-sm d-inline-block w-auto"
                @onchange="OrdenarPorSeleccion">
            <option value="default">Orden original</option>
            <option value="prioridad">Prioridad</option>
        </select>
    </div>
</div>



@if (areasDetalle == null)
{
    <p><em>Cargando áreas detalladas...</em></p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nro de orden</th>
                <th>Nombre de la orden</th>
                <th>Nombre del cliente</th>
                <th>Nombre del área</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Tiempo</th>
                <th>Comentario</th>
                <th>Prioridad</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in FiltrarAreas())
            {
                <tr>
                    <td>@ordenDetalleDTO.NroOT</td>
                    <td>@area.NombreOrden</td>
                    <td>@area.NombreCliente</td>
                    <td>@area.NombreArea</td>
                    <td>@area.Descripcion</td>
                    <td>@area.Estado</td>
                    <td>@area.Tiempo</td>
                    <td>
                        <input type="text" class="form-control"
                               @bind="area.Comentario"
                               @bind:event="oninput"
                               @onchange="() => GuardarComentario(area)" />
                    </td>
                    <td>@area.Prioridad</td>
                    <td>
                        <select class="form-select" @onchange="async e => await CambiarEstado(area.Id, e)">
                            <option label="---Cambiar estado del área---"></option>
                            <option value="Iniciado">Iniciado</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Finalizado">Finalizado</option>
                            <option value="Detenido">Detenido</option>
                        </select>
                        <button class="btn btn-sm btn-danger mt-1"
                                @onclick="async () => await EliminarArea(area.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-secondary mt-3" @onclick="Volver">Volver</button>
}

@code {
    [Parameter] public int NroOT { get; set; }
    public string NombreOrden;
    public string NombreCliente;
    private List<AreaDetalleOrdenListaDTO> areasDetalle = new();
    private string filtroEstado = "";
    private bool soloFinalizados = false;
    private OrdenDetalleDTO ordenDetalleDTO = new OrdenDetalleDTO();
    private AreaDetalleOrdenDTO AreaDetalle = new AreaDetalleOrdenDTO();
    private CrearClienteDTO ClienteDTO = new CrearClienteDTO();
    private AreaDetalleOrdenListaDTO areaDetalleOrdenListaDTO = new AreaDetalleOrdenListaDTO();

    private string modoOrdenamiento = "default";

    private async Task OrdenarPorSeleccion(ChangeEventArgs e)
    {
        modoOrdenamiento = e.Value?.ToString();

        if (modoOrdenamiento == "prioridad")
        {          
            areasDetalle = await Http.GetFromJsonAsync<List<AreaDetalleOrdenListaDTO>>(
                $"api/Area_Detalle_Orden/OrdenadasPorPrioridad/{NroOT}");
        }
        else
        {
            areasDetalle = await Http.GetFromJsonAsync<List<AreaDetalleOrdenListaDTO>>(
                $"api/Area_Detalle_Orden/{NroOT}");
        }

        StateHasChanged();
    }



    protected override async Task OnInitializedAsync()
    {
        AreaDetalle.NroOT = NroOT;
        ordenDetalleDTO.NroOT = NroOT;

        try
        {
            areasDetalle = await Http.GetFromJsonAsync<List<AreaDetalleOrdenListaDTO>>(
                $"api/Area_Detalle_Orden/{NroOT}");

            if (areasDetalle != null && areasDetalle.Any())
            {
                NombreOrden = areasDetalle.First().NombreOrden;
                NombreCliente = areasDetalle.First().NombreCliente;

                foreach (var area in areasDetalle)
                {
                    if (!string.IsNullOrEmpty(area.Comentario))
                    {
                        await JS.InvokeVoidAsync("localStorage.setItem", $"comentario_{area.Id}", area.Comentario);
                        await JS.InvokeVoidAsync("sessionStorage.setItem", $"comentario_{area.Id}", area.Comentario);
                    }
                    else
                    {
                        var comentarioLocal = await JS.InvokeAsync<string>(
                            "localStorage.getItem", $"comentario_{area.Id}");
                        var comentarioSession = await JS.InvokeAsync<string>(
                            "sessionStorage.getItem", $"comentario_{area.Id}");

                        area.Comentario = !string.IsNullOrEmpty(comentarioLocal)
                            ? comentarioLocal
                            : comentarioSession ?? "";
                    }
                }
            }
            else
            {
                Console.WriteLine($"No se encontraron áreas para la orden NroOT {NroOT}");
                NombreOrden = "(sin nombre)";
                NombreCliente = "(sin cliente)";
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al obtener áreas: {ex.InnerException}");
            NombreOrden = "(error)";
            NombreCliente = "(error)";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/Ordenes");
    }

    private void AgregarArea(int OrdenId)
    {
        Navigation.NavigateTo($"/AgregarAreaEnAreaDetalleOrden/{OrdenId}");
    }

    private IEnumerable<AreaDetalleOrdenListaDTO> FiltrarAreas()
    {
        IEnumerable<AreaDetalleOrdenListaDTO> lista = areasDetalle;

        if (!string.IsNullOrEmpty(filtroEstado))
            lista = lista.Where(a => a.Estado == filtroEstado);

        if (soloFinalizados)
            lista = lista.Where(a => a.Estado == "Finalizado");

        return lista;
    }

    private async Task GuardarComentario(AreaDetalleOrdenListaDTO area)
    {
        var comentario = area.Comentario ?? "";

        // Local y session
        await JS.InvokeVoidAsync("sessionStorage.setItem", $"comentario_{area.Id}", comentario);
        await JS.InvokeVoidAsync("localStorage.setItem", $"comentario_{area.Id}", comentario);

        // 🔹 Persistir en backend
        var payload = new { Comentario = comentario };
        var response = await Http.PutAsJsonAsync($"api/Area_Detalle_Orden/{area.Id}/Comentario", payload);

        if (!response.IsSuccessStatusCode)
        {
            var msg = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error al guardar comentario en servidor: {msg}");
        }
    }

    // Cambiar estado
    private async Task CambiarEstado(int id, ChangeEventArgs e)
    {
        var nuevoEstado = e?.Value?.ToString();
        if (string.IsNullOrWhiteSpace(nuevoEstado)) return;

        var payload = new { Estado = nuevoEstado };
        var response = await Http.PutAsJsonAsync($"api/Area_Detalle_Orden/{id}/Estado", payload);

        if (response.IsSuccessStatusCode)
        {
            var area = areasDetalle.FirstOrDefault(a => a.Id == id);
            if (area != null) area.Estado = nuevoEstado;

            await JS.InvokeVoidAsync("alert", "Estado actualizado en el servidor.");
            InvokeAsync(StateHasChanged);
        }
        else
        {
            var msg = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error al actualizar en servidor: {msg}");
        }


        areasDetalle = await Http.GetFromJsonAsync<List<AreaDetalleOrdenListaDTO>>(
                $"api/Area_Detalle_Orden/{NroOT}");
    }

    private async Task EliminarArea(int areaDetalleId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que quieres eliminar esta área asociada al Nro de orden {ordenDetalleDTO.NroOT}?");
        if (!confirm) return;

        var response = await Http.DeleteAsync($"api/Area_Detalle_Orden/{areaDetalleId}");
        if (response.IsSuccessStatusCode)
        {
            areasDetalle.RemoveAll(a => a.Id == areaDetalleId);

            // 🔹 Borrar también de localStorage/sessionStorage
            await JS.InvokeVoidAsync("localStorage.removeItem", $"comentario_{areaDetalleId}");
            await JS.InvokeVoidAsync("sessionStorage.removeItem", $"comentario_{areaDetalleId}");

            await JS.InvokeVoidAsync("alert", "Área eliminada correctamente.");
            Navigation.NavigateTo($"/AreasDetalleOrden/{NroOT}");
        }
        else
        {
            var msg = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error al eliminar: {msg}");
        }
    }
}
