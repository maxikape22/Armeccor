<div class="d-flex justify-content-between align-items-center mb-3">
    <h5></h5>
    <div>
        <label class="form-label me-2">Ordenar por:</label>
        <select class="form-select form-select-sm d-inline-block w-auto"
                @onchange="OrdenarPorSeleccion">
            <option value="default">Orden original</option>
            <option value="prioridad">Prioridad</option>
        </select>
    </div>
</div>



@if (areasDetalle == null)
{
    <p><em>Cargando áreas detalladas...</em></p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nro de orden</th>
                <th>Nombre de la orden</th>
                <th>Nombre del cliente</th>
                <th>Nombre del área</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Tiempo</th>
                <th>Comentario</th>
                <th>Prioridad</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in FiltrarAreas())
            {
                <tr>
                    <td>@ordenDetalleDTO.NroOT</td>
                    <td>@area.NombreOrden</td>
                    <td>@area.NombreCliente</td>
                    <td>@area.NombreArea</td>
                    <td>@area.Descripcion</td>
                    <td>@area.Estado</td>

                    <td>
                        <div class="d-flex flex-column gap-2 align-items-start">
                            <!-- Muestra el tiempo actual -->
                            <span class="fw-bold">@area.Tiempo</span>

                            <!-- Input para ingresar manualmente cuánto tiempo querés descontar -->
                            <input type="number"
                                   class="form-control form-control-sm"
                                   style="width:100px"
                                   @bind="area.CantidadADescontar"
                                   min="1"
                                   placeholder="Cantidad" />

                            @{
                                var clase = area.EstaCorriendo ? "btn-warning" : "btn-success";
                                var texto = area.EstaCorriendo ? "Detener" : "Iniciar";
                                var desactivar = !area.EstaCorriendo && area.Tiempo <= 0;
                            }

                            <button class="btn btn-sm @clase"
                                    disabled="@desactivar"
                                    @onclick="() => ToggleTemporizador(area)">
                                @texto
                            </button>
                        </div>
                    </td>





          





                    <td>
                        <input type="text" class="form-control"
                               @bind="area.Comentario"
                               @bind:event="oninput"
                               @onchange="() => GuardarComentario(area)" />
                    </td>

                    <td style="width:110px">
                        @if (area.Estado != "Finalizado")
                        {
                            <div class="d-flex flex-column align-items-stretch gap-1">
                                <select class="form-select form-select-sm"
                                        @bind="area.Prioridad">
                                    @for (int i = 1; i <= areasDetalle.Count; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>

                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => AplicarPrioridad(area)">
                                    Aplicar
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>

                    <td>
                        <select class="form-select" @onchange="async e => await CambiarEstado(area.Id, e)">
                            <option label="---Cambiar estado del área---"></option>
                            <option value="Iniciado">Iniciado</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Finalizado">Finalizado</option>
                            <option value="Detenido">Detenido</option>
                        </select>
                        <button class="btn btn-sm btn-danger mt-1"
                                @onclick="async () => await EliminarArea(area.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-secondary mt-3" @onclick="Volver">Volver</button>
}

