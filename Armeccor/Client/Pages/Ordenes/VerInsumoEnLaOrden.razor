@page "/ListadoInsumosOrden"
@inject HttpClient Http

<h3>Insumos en Órdenes</h3>

@if (insumosEnOrden == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nro. de OT</th>
                <th>Orden</th>
                <th>Insumo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in insumosEnOrden)
            {
                <tr>
                </tr>
            }
        </tbody>
    </table>
}

@code 
{
    private List<InsumoDetalleOrdenDTO> insumosEnOrden;

    protected override async Task OnInitializedAsync()
    {
        insumosEnOrden = await Http.GetFromJsonAsync<List<InsumoDetalleOrdenDTO>>("api/Ordenes/Insumo_Detalle_Orden");
    }
}