@page "/AgregarAreaEnAreaDetalleOrden/{NroOT:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Net.Http.Json
@inject IJSRuntime js

<h3>Agregar área a la orden: @NroOT</h3>

<div class="card p-3">

    <div class="mb-3">
        <label for="areaSelect" class="form-label">Área</label>
        <select id="areaSelect" class="form-select" @bind="nuevaArea.AreaId">
            <option value="">-- Seleccione un área --</option>
            @foreach (var area in areasDisponibles)
            {
                <option value="@area.Id">@area.NombreArea</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="descripcion" class="form-label">Descripción</label>
        <input id="descripcion" type="text" class="form-control"
               @bind="nuevaArea.Descripcion" />
    </div>

    <InputSelect class="form-select" @bind-Value="nuevaArea.Estado">
        @foreach (var estado in Estados)
        {
            <option value="@estado">@estado</option>
        }
    </InputSelect>

    <div class="mb-3">
        <label for="tiempo" class="form-label">Tiempo (HH:mm:ss)</label>
        <input id="tiempo" type="text" class="form-control"
               @bind="tiempoIngresado"
               placeholder="HH:mm:ss" />
    </div>


    <div class="d-flex justify-content-end">
        <button class="btn btn-success" @onclick="GuardarArea">Aceptar</button>
        <button class="btn btn-secondary ms-2" @onclick="Volver">Volver</button>
    </div>
</div>

<ConfirmationModal @ref="confirmationModal" />

@code
{
    private ConfirmationModal? confirmationModal;

    private string tiempoIngresado = "00:00:00";

    [Parameter] public int NroOT { get; set; }
    [Parameter] public string NombreOrden { get; set; }
    [Parameter] public string NombreCliente { get; set; }
    private OrdenDetalleDTO ordenDetalleDTO = new OrdenDetalleDTO();
    private AreaDetalleOrdenDTO AreaDetalle = new AreaDetalleOrdenDTO();
    private CrearClienteDTO ClienteDTO = new CrearClienteDTO();
    private AreaDetalleOrdenListaDTO areaDetalleOrdenListaDTO = new AreaDetalleOrdenListaDTO();

    private AreaDetalleOrdenDTO nuevaArea = new()
    {
        Estado = "Pendiente" // Valor por defecto
    };

    private List<AreaListaDTO> areasDisponibles = new();
    private List<string> Estados = new() 
    {             
        "Pendiente",
        "Iniciado",
        "Detenido"
    };
    private List<AreaDetalleOrdenListaDTO> listaDTOs = new List<AreaDetalleOrdenListaDTO>();

    protected override async Task OnInitializedAsync()
    {
        AreaDetalle.NroOT = NroOT;
        ordenDetalleDTO.NroOT = NroOT;
        areaDetalleOrdenListaDTO.NombreOrden = NombreOrden;
        areaDetalleOrdenListaDTO.NombreCliente = NombreCliente;
        // ✅ Cargar las áreas desde el backend
        areasDisponibles = await Http.GetFromJsonAsync<List<AreaListaDTO>>("api/Areas");
    }

    private async Task GuardarArea()
    {
        try
        {
            nuevaArea.NroOT = NroOT;

            // ✅ Convertir el string a TimeSpan
            if (!TimeSpan.TryParse(tiempoIngresado, out var ts))
            {
                //await js.InvokeVoidAsync("alert", "Formato inválido. Usa HH:mm:ss");
                await confirmationModal.ShowInfoAsync("Formato inválido. Usa HH:mm:ss");
                return;
            }

            nuevaArea.Tiempo = ts; // asignar al DTO

            var resp = await Http.PostAsJsonAsync(
                "api/Area_Detalle_Orden/AreaDetallaEnOrden", nuevaArea);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<AreaDetalleOrdenDTO>();
                // await js.InvokeVoidAsync("alert", "Área detallada agregada correctamente.");
                // Navigation.NavigateTo($"/AreasDetalleOrden/{NroOT}");
                if (confirmationModal != null)
                {
                    await confirmationModal.ShowInfoAsync(
                        "✅ Área registrada correctamente en la orden.",
                        async () =>
                        {
                            Navigation.NavigateTo($"/AreasDetalleOrden/{NroOT}");
                            await Task.CompletedTask;
                        });
                }
            }
            else
            {
                var mensajeError = await resp.Content.ReadAsStringAsync();
                await confirmationModal.ShowInfoAsync(mensajeError);
            }
        }
        catch (Exception)
        {
            await js.InvokeVoidAsync("alert", "No se pudó registrar el área detallada");
        }
    }


    private void Volver()
    {
        Navigation.NavigateTo($"/AreasDetalleOrden/{NroOT}");
    }
}